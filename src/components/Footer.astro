---
// 페이지 공통 푸터 (언어 인식형)
const path = Astro.url.pathname;
const lang: 'ko' | 'en' | 'zh' = path.startsWith('/en') ? 'en' : path.startsWith('/zh') ? 'zh' : 'ko';
const base = lang === 'en' ? '/en' : lang === 'zh' ? '/zh' : '';
const px = (h: string) => (h.startsWith('/') ? base + h : h);

// 링크 주소(언어 공통). 라벨만 언어별로 바뀜.
const hrefsCompany = ['/#story', '#', '#', '#'];
const hrefsProducts = ['/#products', '/#products', '/#products', '#'];
const hrefsSupport = ['/#support', '#', '#', '#', '#'];

const F = {
  ko: {
    tagline: '공간에 가치를 더하는 기업<br>사무용·산업용·박물관용 랙 시스템 전문 제조기업',
    hqLabel: '본사 / 공장',
    hqAddr: '충청북도 음성군 삼성면 대덕로 63-75<br>Tel. 043) 878-7341~3 &nbsp;|&nbsp; Fax. 043) 878-7344',
    seoulLabel: '서울 영업본부 / 박물관사업부',
    seoulAddr: '서울특별시 광진구 자양로 58 태림빌딩 4층<br>Tel. 02) 2235-2693~4 &nbsp;|&nbsp; Fax. 02) 2235-2695',
    emailLabel: 'Email',
    colCompany: '회사 소개', colProducts: '제품', colSupport: '고객 지원',
    linksCompany: ['회사 소개', '연혁 & 비전', '인증서', '찾아오시는 길'],
    linksProducts: ['이동식 서가 / 모빌랙', '박물관용 수장대', '중량랙 / 파렛트랙', '맞춤 옵션'],
    linksSupport: ['상담 문의', 'A/S 신청', '카탈로그 다운로드', 'DW MALL', 'FAQ'],
    bizName: '상호명:', bizTel: '대표전화:', bizFax: '팩스:', bizReg: '사업자등록번호:',
    companyName: '(주)대원모빌랙',
  },
  en: {
    tagline: 'Adding value to every space<br>A specialist manufacturer of office, industrial and museum rack systems',
    hqLabel: 'Headquarters / Factory',
    hqAddr: '63-75 Daedeok-ro, Samseong-myeon, Eumseong-gun, Chungcheongbuk-do<br>Tel. +82-43-878-7341~3 &nbsp;|&nbsp; Fax. +82-43-878-7344',
    seoulLabel: 'Seoul Sales HQ / Museum Division',
    seoulAddr: '4F, Taerim Bldg, 58 Jayang-ro, Gwangjin-gu, Seoul<br>Tel. +82-2-2235-2693~4 &nbsp;|&nbsp; Fax. +82-2-2235-2695',
    emailLabel: 'Email',
    colCompany: 'Company', colProducts: 'Products', colSupport: 'Support',
    linksCompany: ['About Us', 'History & Vision', 'Certifications', 'Directions'],
    linksProducts: ['Mobile Shelving / Rack', 'Museum Storage Rack', 'Heavy-Duty / Pallet Rack', 'Custom Options'],
    linksSupport: ['Contact', 'Service Request', 'Catalog Download', 'DW MALL', 'FAQ'],
    bizName: 'Company:', bizTel: 'Tel:', bizFax: 'Fax:', bizReg: 'Business Reg. No.:',
    companyName: 'Daewon Mobile Rack Co., Ltd.',
  },
  zh: {
    tagline: '为空间增添价值的企业<br>办公·工业·博物馆用货架系统专业制造商',
    hqLabel: '总部 / 工厂',
    hqAddr: '忠清北道 阴城郡 三成面 大德路 63-75<br>电话 +82-43-878-7341~3 &nbsp;|&nbsp; 传真 +82-43-878-7344',
    seoulLabel: '首尔营业总部 / 博物馆事业部',
    seoulAddr: '首尔特别市 广津区 紫阳路 58 泰林大厦 4层<br>电话 +82-2-2235-2693~4 &nbsp;|&nbsp; 传真 +82-2-2235-2695',
    emailLabel: 'Email',
    colCompany: '公司介绍', colProducts: '产品', colSupport: '客户支持',
    linksCompany: ['公司介绍', '沿革与愿景', '认证证书', '交通指南'],
    linksProducts: ['移动书架 / 密集架', '博物馆收藏架', '重型 / 货架', '定制选项'],
    linksSupport: ['咨询', '售后申请', '目录下载', 'DW MALL', 'FAQ'],
    bizName: '公司名称:', bizTel: '电话:', bizFax: '传真:', bizReg: '营业执照号:',
    companyName: '大元移动架股份有限公司',
  },
}[lang];
---

<footer>
  <div class="footer-top">
    <div class="footer-brand">
      <img src="/logo-white.png" alt="(주)대원모빌랙 로고" />
      <p set:html={F.tagline}></p>

      <div class="footer-info-block">
        <div class="footer-info-label">{F.hqLabel}</div>
        <p class="footer-info-text" set:html={F.hqAddr}></p>
      </div>

      <div class="footer-info-block">
        <div class="footer-info-label">{F.seoulLabel}</div>
        <p class="footer-info-text" set:html={F.seoulAddr}></p>
      </div>

      <div>
        <div class="footer-info-label">{F.emailLabel}</div>
        <a href="mailto:info@mobile-rack.co.kr" class="footer-email">
          info@mobile-rack.co.kr
        </a>
      </div>
    </div>

    <div>
      <div class="footer-col-title">{F.colCompany}</div>
      <ul class="footer-links">
        {F.linksCompany.map((label, i) => (<li><a href={px(hrefsCompany[i])}>{label}</a></li>))}
      </ul>
    </div>
    <div>
      <div class="footer-col-title">{F.colProducts}</div>
      <ul class="footer-links">
        {F.linksProducts.map((label, i) => (<li><a href={px(hrefsProducts[i])}>{label}</a></li>))}
      </ul>
    </div>
    <div>
      <div class="footer-col-title">{F.colSupport}</div>
      <ul class="footer-links">
        {F.linksSupport.map((label, i) => (<li><a href={px(hrefsSupport[i])}>{label}</a></li>))}
      </ul>
    </div>
  </div>

  <div class="footer-business">
    <p>
      <span>{F.bizName}</span> {F.companyName} &nbsp;|&nbsp;
      <span>{F.bizTel}</span> 02) 2235-2693~4 &nbsp;|&nbsp;
      <span>{F.bizFax}</span> 02) 2235-2695 &nbsp;|&nbsp;
      <span>{F.bizReg}</span> 126-81-68669
    </p>
  </div>

  <div class="footer-bottom">
    <span class="footer-copy">Copyright © Daewon Mobile Rack. All Rights Reserved.</span>
    <div class="footer-badges">
      <span class="footer-badge">ISO 9001</span>
      <span class="footer-badge">ISO 14001</span>
      <span class="footer-badge">Good Design</span>
      <span class="footer-badge">Inno-Biz</span>
    </div>
  </div>
</footer>

<style>
footer { background: var(--c-dark); padding: 64px 80px 40px; }
.footer-top {
  display: grid; grid-template-columns: 2fr 1fr 1fr 1fr;
  gap: 48px; margin-bottom: 48px;
  padding-bottom: 48px;
  border-bottom: 1px solid rgba(255,255,255,0.08);
}
.footer-brand img { height: 44px; width: auto; display: block; margin-bottom: 16px; }
.footer-brand p {
  font-size: 12px; color: rgba(255,255,255,0.35); line-height: 1.7; max-width: 240px;
  margin-bottom: 20px;
}
.footer-info-block { margin-bottom: 16px; }
.footer-info-label {
  font-family: 'NanumSquare', sans-serif;
  font-size: 10px; letter-spacing: 0.12em; color: var(--c-teal2);
  margin-bottom: 8px; text-transform: uppercase;
}
.footer-info-text { font-size: 12px; color: rgba(255,255,255,0.45); line-height: 1.8; }
.footer-email {
  font-size: 12px; color: rgba(255,255,255,0.55); text-decoration: none;
  transition: color 0.2s;
}
.footer-email:hover { color: var(--c-teal2); }
.footer-col-title {
  font-family: 'Barlow Condensed', sans-serif;
  font-size: 13px; font-weight: 700; letter-spacing: 0.15em;
  text-transform: uppercase; color: rgba(255,255,255,0.4);
  margin-bottom: 16px;
}
.footer-links { list-style: none; display: flex; flex-direction: column; gap: 10px; }
.footer-links a {
  font-size: 13px; color: rgba(255,255,255,0.55);
  text-decoration: none; transition: color 0.2s;
}
.footer-links a:hover { color: var(--c-teal2); }

.footer-business {
  padding: 20px 0;
  border-top: 1px solid rgba(255,255,255,0.06);
  border-bottom: 1px solid rgba(255,255,255,0.06);
  margin-bottom: 24px;
}
.footer-business p {
  font-size: 11px; color: rgba(255,255,255,0.3); line-height: 2; word-break: keep-all;
}
.footer-business span { color: rgba(255,255,255,0.45); font-weight: 500; }

.footer-bottom { display: flex; justify-content: space-between; align-items: center; }
.footer-copy {
  font-family: 'NanumSquare', sans-serif;
  font-size: 10px; color: rgba(255,255,255,0.25);
  letter-spacing: 0.1em;
}
.footer-badges { display: flex; gap: 12px; }
.footer-badge {
  font-family: 'NanumSquare', sans-serif;
  font-size: 9px; letter-spacing: 0.1em;
  color: rgba(255,255,255,0.3);
  border: 1px solid rgba(255,255,255,0.1);
  padding: 4px 10px; border-radius: 2px; text-transform: uppercase;
}

@media (max-width: 768px) {
  footer { padding: 48px 24px 32px; }
  .footer-top { grid-template-columns: 1fr; gap: 32px; }
  .footer-bottom { flex-direction: column; gap: 16px; }
}
</style>
