---
// 상단 네비게이션 바 (언어 인식형)
// 현재 주소로 언어를 판단: /en → 영어, /zh → 중국어, 그 외 → 한국어
interface Props {
  active?: 'story' | 'products' | 'how' | 'portfolio' | 'support' | null;
}
const { active = null } = Astro.props;

const path = Astro.url.pathname;
const lang: 'ko' | 'en' | 'zh' = path.startsWith('/en') ? 'en' : path.startsWith('/zh') ? 'zh' : 'ko';
const base = lang === 'en' ? '/en' : lang === 'zh' ? '/zh' : '';

const L = {
  ko: { cta: '견적 문의', menuOpen: '메뉴 열기' },
  en: { cta: 'Get a Quote', menuOpen: 'Open menu' },
  zh: { cta: '获取报价', menuOpen: '打开菜单' },
}[lang];
---

<nav>
  <a href={`${base}/`} class="nav-logo">
    <img src="/logo.png" alt="(주)대원모빌랙 로고" />
  </a>
  <ul class="nav-links">
    <li><a href={`${base}/#story`} class:list={[active === 'story' && 'active']}>Our Story</a></li>
    <li><a href={`${base}/#products`} class:list={[active === 'products' && 'active']}>Product</a></li>
    <li><a href={`${base}/#how`} class:list={[active === 'how' && 'active']}>How to Use</a></li>
    <li><a href={`${base}/#cases`} class:list={[active === 'portfolio' && 'active']}>Portfolio</a></li>
    <li><a href={`${base}/#support`} class:list={[active === 'support' && 'active']}>Support</a></li>
  </ul>
  <div class="nav-right">
    <div class="lang-switcher">
      <a href="/" class:list={['lang-btn', lang === 'ko' && 'active']}>KO</a>
      <a href="/en/" class:list={['lang-btn', lang === 'en' && 'active']}>EN</a>
      <a href="/zh/" class:list={['lang-btn', lang === 'zh' && 'active']}>中</a>
    </div>
    <a href={`${base}/#support`} class="nav-cta">{L.cta}</a>
  </div>
  <button class="nav-hamburger" id="hamburger" aria-label={L.menuOpen}>
    <span></span><span></span><span></span>
  </button>
</nav>

<div class="mobile-menu" id="mobileMenu">
  <ul>
    <li><a href={`${base}/#story`}>Our Story</a></li>
    <li><a href={`${base}/#products`}>Product</a></li>
    <li><a href={`${base}/#how`}>How to Use</a></li>
    <li><a href={`${base}/#cases`}>Portfolio</a></li>
    <li><a href={`${base}/#support`}>Support</a></li>
  </ul>
  <div class="mobile-menu-btns">
    <div class="lang-switcher">
      <a href="/" class:list={['lang-btn', lang === 'ko' && 'active']}>KO</a>
      <a href="/en/" class:list={['lang-btn', lang === 'en' && 'active']}>EN</a>
      <a href="/zh/" class:list={['lang-btn', lang === 'zh' && 'active']}>中</a>
    </div>
    <a href={`${base}/#support`} class="nav-cta" style="flex:1; text-align:center;">{L.cta}</a>
  </div>
</div>

<script>
  const hamburger = document.getElementById('hamburger');
  const mobileMenu = document.getElementById('mobileMenu');
  hamburger?.addEventListener('click', () => {
    hamburger.classList.toggle('open');
    mobileMenu?.classList.toggle('open');
  });
</script>

<style>
nav {
  position: fixed; top: 0; left: 0; right: 0; z-index: 100;
  height: var(--nav-h);
  display: flex; align-items: center; justify-content: space-between;
  padding: 0 48px;
  background: rgba(21,26,20,0.92);
  backdrop-filter: blur(16px);
  border-bottom: 1px solid rgba(255,255,255,0.07);
}
.nav-logo { display: flex; align-items: center; gap: 10px; text-decoration: none; }
.nav-logo img { height: 38px; width: auto; display: block; }
.nav-links {
  display: flex; align-items: center; gap: 36px;
  list-style: none;
}
.nav-links a {
  font-family: 'Barlow Condensed', 'NanumSquare', 'NanumSquareOTF', sans-serif;
  font-size: 14px; font-weight: 600;
  letter-spacing: 0.12em;
  color: rgba(255,255,255,0.65);
  text-decoration: none;
  text-transform: uppercase;
  transition: color 0.2s;
  position: relative;
}
.nav-links a::after {
  content: ''; position: absolute; bottom: -4px; left: 0;
  width: 0; height: 1.5px; background: var(--c-teal2);
  transition: width 0.3s var(--ease);
}
.nav-links a:hover, .nav-links a.active { color: var(--c-white); }
.nav-links a:hover::after, .nav-links a.active::after { width: 100%; }
.nav-right { display: flex; align-items: center; gap: 20px; }
.lang-switcher { display: flex; gap: 2px; }
.lang-btn {
  font-family: 'Barlow Condensed', sans-serif;
  font-size: 12px; font-weight: 600;
  background: transparent; border: 1px solid rgba(255,255,255,0.15);
  color: rgba(255,255,255,0.5);
  padding: 5px 9px; cursor: pointer;
  letter-spacing: 0.1em; transition: all 0.2s;
  text-decoration: none; display: inline-flex; align-items: center; line-height: 1;
}
.lang-btn:hover { color: var(--c-white); border-color: rgba(255,255,255,0.3); }
.lang-btn.active { background: var(--c-teal2); color: var(--c-dark); border-color: var(--c-teal2); }
.lang-btn:disabled { opacity: 0.4; cursor: not-allowed; }
.lang-btn:disabled:hover { color: rgba(255,255,255,0.5); border-color: rgba(255,255,255,0.15); }
.nav-cta {
  font-family: 'NanumSquare', 'NanumSquareOTF', sans-serif;
  font-size: 13px; font-weight: 700;
  background: var(--c-teal2); color: var(--c-dark);
  border: none; padding: 9px 18px; border-radius: 2px;
  cursor: pointer; letter-spacing: 0.05em;
  transition: background 0.2s, transform 0.2s;
  text-decoration: none; display: inline-block;
}
.nav-cta:hover { background: var(--c-teal); transform: translateY(-1px); }

.nav-hamburger {
  display: none;
  flex-direction: column; gap: 5px;
  background: none; border: none; cursor: pointer; padding: 4px;
}
.nav-hamburger span {
  display: block; width: 22px; height: 2px;
  background: rgba(255,255,255,0.8); border-radius: 2px;
  transition: all 0.3s var(--ease);
}
.nav-hamburger.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
.nav-hamburger.open span:nth-child(2) { opacity: 0; }
.nav-hamburger.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

.mobile-menu {
  display: none;
  position: fixed; top: var(--nav-h); left: 0; right: 0;
  background: rgba(21,26,20,0.98);
  backdrop-filter: blur(20px);
  z-index: 99; padding: 24px;
  border-bottom: 1px solid rgba(255,255,255,0.08);
  transform: translateY(-10px); opacity: 0;
  transition: all 0.3s var(--ease);
  pointer-events: none;
}
.mobile-menu.open {
  transform: translateY(0); opacity: 1; pointer-events: all;
}
.mobile-menu ul { list-style: none; margin-bottom: 20px; }
.mobile-menu ul li { border-bottom: 1px solid rgba(255,255,255,0.06); }
.mobile-menu ul a {
  display: block; padding: 16px 0;
  font-family: 'Barlow Condensed', sans-serif;
  font-size: 16px; font-weight: 600; letter-spacing: 0.1em;
  color: rgba(255,255,255,0.7); text-decoration: none;
  text-transform: uppercase;
}
.mobile-menu-btns { display: flex; gap: 12px; align-items: center; }

@media (max-width: 768px) {
  nav { padding: 0 20px; }
  .nav-links, .nav-right .lang-switcher, .nav-cta { display: none; }
  .nav-hamburger { display: flex; }
  .mobile-menu { display: block; }
  .nav-right { gap: 0; }
}
</style>
