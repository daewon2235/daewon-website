---
// 홈페이지 공유 부품 — 모든 언어가 이 마크업/디자인/기능을 공유합니다.
// 화면에 보이는 글자는 전부 ../i18n/home.ts 에서 가져옵니다 (lang에 따라 ko/en/zh).
import { getCollection } from 'astro:content';
import { categoryMap } from '../lib/categories';
import { homeContent } from '../i18n/home';

interface Props { lang: 'ko' | 'en' | 'zh'; }
const { lang } = Astro.props;
const t = (homeContent as Record<string, any>)[lang] ?? homeContent.ko;
const pc = t.products.cards;

// 발행된 사례가 1건이라도 있는 카테고리 → 메인 카드 자동 활성화 (원본 로직 그대로)
const publishedCases = await getCollection('cases', ({ data }) => data.published);
const activeCats = new Set(publishedCases.flatMap((c) => c.data.categories));
const slugByName = Object.fromEntries(
  Object.entries(categoryMap).map(([slug, name]) => [name, slug])
);
---

<section class="hero">
  <div class="hero-left">
    <span class="hero-tag">{t.hero.tag}</span>
    <h1 class="hero-h1">
      <span class="line"><span>CREATE,</span></span>
      <span class="line"><span>DESIGN,</span></span>
      <span class="line"><span>HUMAN TECH.</span></span>
    </h1>
    <p class="hero-sub" set:html={t.hero.sub}></p>
    <div class="hero-btns">
      <a href="#products" class="btn-primary">{t.hero.btnProducts}</a>
      <a href="#story" class="btn-ghost">{t.hero.btnStory}</a>
    </div>
    <div class="hero-stats">
      {t.hero.stats.map((s) => (
        <div>
          <div class="hero-stat-num">{s.num}<span>{s.unit}</span></div>
          <div class="hero-stat-label">{s.label}</div>
        </div>
      ))}
    </div>
  </div>
  <div class="hero-right">
    <div class="hero-line"></div>
    <div class="hero-grid">
      {t.hero.images.map((img, i) => (
        <div class:list={['hero-img', i === 0 && 'active']} data-label={img.label}>
          <div class="hero-img-inner" style={`background-image:url('${img.src}');`}></div>
          <span class="hero-overlay-tag">{img.tag}</span>
        </div>
      ))}
    </div>
    <div class="hero-dots" id="heroDots" data-dot-label={t.hero.dotLabel}></div>
  </div>
</section>

<!-- CERT MARQUEE -->
<div class="cert-strip">
  <div class="cert-track">
    {[...t.certs, ...t.certs].map((c) => (
      <span class="cert-item"><span>✦</span>{c}</span>
    ))}
  </div>
</div>

<!-- OUR STORY -->
<section class="section story" id="story">
  <div class="story-grid">
    <div class="story-left reveal">
      <span class="section-tag">{t.story.tag}</span>
      <h2 class="section-h2" set:html={t.story.h2}></h2>
      <div class="story-quote">
        <p set:html={t.story.quote}></p>
      </div>
      {t.story.body.map((p) => (
        <p class="story-body" set:html={p}></p>
      ))}
      <p class="story-sign" set:html={t.story.sign}></p>
    </div>
    <div class="story-right reveal">
      <div class="vision-cards">
        {t.story.vision.map((v) => (
          <div class="vision-card">
            <div class="vision-num">{v.num}</div>
            <div>
              <div class="vision-title">{v.title}</div>
              <div class="vision-desc">{v.desc}</div>
            </div>
          </div>
        ))}
      </div>
      <div class="history-strip">
        <div class="history-title">{t.story.milestonesTitle} <span class="history-title-kr">{t.story.milestonesTitleSub}</span></div>
        <div class="history-list">
          {t.story.milestones.map((m) => (
            <div class="history-item"><span class="history-year">{m.year}</span><span class="history-event">{m.event}</span></div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<!-- PRODUCTS -->
<section class="section products" id="products">
  <div class="products-header reveal">
    <div>
      <span class="section-tag">{t.products.tag}</span>
      <h2 class="section-h2">{t.products.h2}</h2>
    </div>
    <div class="product-filter">
      <button class="filter-btn active">{t.products.filterAll}</button>
      {t.products.filters.map((f) => (
        <a class="filter-btn" href={f.href}>{f.label}</a>
      ))}
    </div>
  </div>
  <div class="products-grid reveal">
    <a class="product-card" href={pc[0].href}>
      <div class="product-img" style="height:320px; --t1: rgba(30,48,32,0.66); --t2: rgba(22,37,22,0.86); background: url('/mobilerack.jpg') center/cover;">
        <div class="product-tint"></div>
        <div class="product-img-icon">{pc[0].icon}</div>
        {pc[0].badge && <span class="product-img-badge">{pc[0].badge}</span>}
      </div>
      <div class="product-overlay"></div>
      <div class="product-body">
        <span class="product-cat">{pc[0].cat}</span>
        <div class="product-name">{pc[0].name}</div>
        <span class="product-name-en">{pc[0].nameEn}</span>
        <p class="product-desc">{pc[0].desc}</p>
        <div class="product-tags">
          {pc[0].tags.map((tag) => (<span class="product-tag">{tag}</span>))}
        </div>
      </div>
    </a>
    <a class="product-card" href={pc[1].href}>
      <div class="product-img" style="height:320px; --t1: rgba(26,42,46,0.58); --t2: rgba(16,32,37,0.82); background: url('/museum.jpg') center/cover;">
        <div class="product-tint"></div>
        <div class="product-img-icon">{pc[1].icon}</div>
        {pc[1].badge && <span class="product-img-badge">{pc[1].badge}</span>}
      </div>
      <div class="product-overlay"></div>
      <div class="product-body">
        <span class="product-cat">{pc[1].cat}</span>
        <div class="product-name">{pc[1].name}</div>
        <span class="product-name-en">{pc[1].nameEn}</span>
        <p class="product-desc">{pc[1].desc}</p>
        <div class="product-tags">
          {pc[1].tags.map((tag) => (<span class="product-tag">{tag}</span>))}
        </div>
      </div>
    </a>
    <a class="product-card" href={pc[2].href}>
      <div class="product-img" style="height:320px; --t1: rgba(40,32,26,0.62); --t2: rgba(30,22,16,0.84); background: url('/heavy.jpg') center/cover;">
        <div class="product-tint"></div>
        <div class="product-img-icon">{pc[2].icon}</div>
        {pc[2].badge && <span class="product-img-badge">{pc[2].badge}</span>}
      </div>
      <div class="product-overlay"></div>
      <div class="product-body">
        <span class="product-cat">{pc[2].cat}</span>
        <div class="product-name">{pc[2].name}</div>
        <span class="product-name-en">{pc[2].nameEn}</span>
        <p class="product-desc">{pc[2].desc}</p>
        <div class="product-tags">
          {pc[2].tags.map((tag) => (<span class="product-tag">{tag}</span>))}
        </div>
      </div>
    </a>
    <a class="product-card" href={pc[3].href}>
      <div class="product-img" style="height:320px; --t1: rgba(32,30,40,0.66); --t2: rgba(24,22,30,0.88); background: url('/option.jpg') center/cover;">
        <div class="product-tint"></div>
        <div class="product-img-icon">{pc[3].icon}</div>
        {pc[3].badge && <span class="product-img-badge">{pc[3].badge}</span>}
      </div>
      <div class="product-overlay"></div>
      <div class="product-body">
        <span class="product-cat">{pc[3].cat}</span>
        <div class="product-name">{pc[3].name}</div>
        <span class="product-name-en">{pc[3].nameEn}</span>
        <p class="product-desc">{pc[3].desc}</p>
        <div class="product-tags">
          {pc[3].tags.map((tag) => (<span class="product-tag">{tag}</span>))}
          {pc[3].tagsMore && pc[3].tagsMore.map((tag) => (<span class="product-tag tag-hidden">{tag}</span>))}
          <button class="product-tag-toggle" type="button" data-more={t.products.moreLabel} data-less={t.products.lessLabel}>{t.products.moreLabel}</button>
        </div>
      </div>
    </a>
  </div>
</section>

<!-- BENEFITS -->
<div class="benefits">
  {t.benefits.map((b) => (
    <div class="benefit reveal">
      <div class="benefit-bar"></div>
      <div class="benefit-num">{b.num}<small style="font-size:28px">{b.unit}</small></div>
      <div class="benefit-title">{b.title}</div>
      <div class="benefit-desc">{b.desc}</div>
    </div>
  ))}
</div>

<!-- HOW TO USE -->
<section class="section how" id="how">
  <span class="section-tag">{t.how.tag}</span>
  <h2 class="section-h2 reveal" style="color:var(--c-white)" set:html={t.how.h2}></h2>
  <p class="how-intro reveal">{t.how.intro}</p>
  <div class="how-grid">
    {t.how.steps.map((s) => (
      <a class="how-card reveal" href="#support">
        <div class="how-num">{s.num}</div>
        <div class="how-title">{s.title}</div>
        <div class="how-desc">{s.desc}</div>
        <span class="how-cta">{t.how.cta}</span>
      </a>
    ))}
  </div>
</section>

<!-- CASE STUDIES -->
<section class="section how cases-section" id="cases">
  <span class="section-tag">{t.cases.tag}</span>
  <h2 class="section-h2 reveal" style="color:var(--c-white)">{t.cases.h2}</h2>
  <p class="how-intro reveal">{t.cases.intro}</p>
  <div class="use-cases reveal">
    <!-- 박물관 -->
    <a href={activeCats.has('박물관') ? `/cases/${slugByName['박물관']}` : undefined}
       class:list={['use-case', activeCats.has('박물관') ? 'use-case-active' : 'use-case-disabled']}>
      <div class="use-case-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-label={t.cases.labels['박물관']}>
          <path d="M3 9l9-5 9 5"/>
          <line x1="3" y1="10" x2="21" y2="10"/>
          <line x1="6" y1="10" x2="6" y2="18"/>
          <line x1="10" y1="10" x2="10" y2="18"/>
          <line x1="14" y1="10" x2="14" y2="18"/>
          <line x1="18" y1="10" x2="18" y2="18"/>
          <line x1="3" y1="18" x2="21" y2="18"/>
          <line x1="2.5" y1="21" x2="21.5" y2="21"/>
        </svg>
      </div>
      <div class="use-case-name">{t.cases.labels['박물관']}</div>
      <span class:list={['use-case-status', activeCats.has('박물관') ? 'status-active' : 'status-soon']}>{activeCats.has('박물관') ? t.cases.statusActive : t.cases.statusSoon}</span>
    </a>
    <!-- 도서관 -->
    <a href={activeCats.has('도서관') ? `/cases/${slugByName['도서관']}` : undefined}
       class:list={['use-case', activeCats.has('도서관') ? 'use-case-active' : 'use-case-disabled']}>
      <div class="use-case-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-label={t.cases.labels['도서관']}>
          <rect x="3" y="4" width="3.2" height="16" rx="0.4"/>
          <rect x="7.4" y="6" width="3.2" height="14" rx="0.4"/>
          <rect x="11.8" y="3" width="3.2" height="17" rx="0.4"/>
          <path d="M17 6.2l3.6 0.9-3 13.4-3.6-0.9z"/>
        </svg>
      </div>
      <div class="use-case-name">{t.cases.labels['도서관']}</div>
      <span class:list={['use-case-status', activeCats.has('도서관') ? 'status-active' : 'status-soon']}>{activeCats.has('도서관') ? t.cases.statusActive : t.cases.statusSoon}</span>
    </a>
    <!-- 교육기관 -->
    <a href={activeCats.has('교육기관') ? `/cases/${slugByName['교육기관']}` : undefined}
       class:list={['use-case', activeCats.has('교육기관') ? 'use-case-active' : 'use-case-disabled']}>
      <div class="use-case-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-label={t.cases.labels['교육기관']}>
          <path d="M2 9.5l10-4.5 10 4.5-10 4.5z"/>
          <path d="M6 11.3v5.2c0 1.4 2.7 2.5 6 2.5s6-1.1 6-2.5v-5.2"/>
          <line x1="22" y1="9.5" x2="22" y2="15"/>
          <circle cx="22" cy="16" r="0.6" fill="currentColor" stroke="none"/>
        </svg>
      </div>
      <div class="use-case-name">{t.cases.labels['교육기관']}</div>
      <span class:list={['use-case-status', activeCats.has('교육기관') ? 'status-active' : 'status-soon']}>{activeCats.has('교육기관') ? t.cases.statusActive : t.cases.statusSoon}</span>
    </a>
    <!-- 공공기관 -->
    <a href={activeCats.has('공공기관') ? `/cases/${slugByName['공공기관']}` : undefined}
       class:list={['use-case', activeCats.has('공공기관') ? 'use-case-active' : 'use-case-disabled']}>
      <div class="use-case-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-label={t.cases.labels['공공기관']}>
          <line x1="12" y1="2" x2="12" y2="8"/>
          <path d="M12 2.6l3.2 1.1-3.2 1.1"/>
          <rect x="4.5" y="8" width="15" height="11.5" rx="0.4"/>
          <rect x="10" y="14" width="4" height="5.5"/>
          <line x1="7" y1="11.5" x2="9" y2="11.5"/>
          <line x1="15" y1="11.5" x2="17" y2="11.5"/>
          <line x1="3" y1="20.5" x2="21" y2="20.5"/>
        </svg>
      </div>
      <div class="use-case-name">{t.cases.labels['공공기관']}</div>
      <span class:list={['use-case-status', activeCats.has('공공기관') ? 'status-active' : 'status-soon']}>{activeCats.has('공공기관') ? t.cases.statusActive : t.cases.statusSoon}</span>
    </a>
    <!-- 창고·물류 -->
    <a href={activeCats.has('창고·물류') ? `/cases/${slugByName['창고·물류']}` : undefined}
       class:list={['use-case', activeCats.has('창고·물류') ? 'use-case-active' : 'use-case-disabled']}>
      <div class="use-case-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-label={t.cases.labels['창고·물류']}>
          <path d="M3 10.5L12 5l9 5.5V20H3z"/>
          <line x1="3" y1="13.5" x2="21" y2="13.5"/>
          <line x1="3" y1="16.5" x2="21" y2="16.5"/>
          <line x1="3" y1="20" x2="21" y2="20"/>
          <line x1="12" y1="13.5" x2="12" y2="20"/>
        </svg>
      </div>
      <div class="use-case-name">{t.cases.labels['창고·물류']}</div>
      <span class:list={['use-case-status', activeCats.has('창고·물류') ? 'status-active' : 'status-soon']}>{activeCats.has('창고·물류') ? t.cases.statusActive : t.cases.statusSoon}</span>
    </a>
  </div>
</section>

<!-- SUPPORT -->
<section class="section support" id="support">
  <div class="support-grid">
    <div class="support-left reveal">
      <span class="section-tag">{t.support.tag}</span>
      <h2 class="section-h2" set:html={t.support.h2}></h2>
      <p style="font-size:14px;color:var(--c-muted);line-height:1.8;margin-bottom:36px;">{t.support.intro}</p>
      <div class="support-cards">
        {t.support.cards.map((card) => (
          card.kind === 'soon' ? (
            <a class="support-card support-card-soon js-soon" role="button" tabindex="0" aria-disabled="true" data-soon-msg={card.soonMsg}>
              <div class="support-icon">{card.icon}</div>
              <div>
                <div class="support-card-title">{card.title}</div>
                <div class="support-card-desc">{card.desc}</div>
              </div>
              <span class="soon-badge">{card.badge}</span>
            </a>
          ) : (
            <a href="#contact" class="support-card js-flash">
              <div class="support-icon">{card.icon}</div>
              <div>
                <div class="support-card-title">{card.title}</div>
                <div class="support-card-desc">{card.desc}</div>
              </div>
              <span class="support-arrow">→</span>
            </a>
          )
        ))}
      </div>
    </div>
    <div class="support-right reveal">
      <div class="contact-card" id="contact">
        <div class="contact-title">{t.support.contact.title}</div>
        <div class="contact-sub">{t.support.contact.sub}</div>
        <div class="contact-info">
          {t.support.contact.rows.map((r) => (
            <div class="contact-row">
              <span class="contact-label">{r.label}</span>
              <span class="contact-value">{r.value}</span>
            </div>
          ))}
        </div>
        <a href="http://pf.kakao.com/_yxkjlG/chat" target="_blank" rel="noopener" class="kakao-btn">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 3C6.477 3 2 6.477 2 10.8c0 2.7 1.7 5.1 4.3 6.6l-1.1 4 4.5-3c.8.1 1.5.2 2.3.2 5.523 0 10-3.477 10-7.8S17.523 3 12 3z"/></svg>
          {t.support.contact.kakao}
        </a>
        <div class="contact-sns">
          <span class="contact-sns-label">{t.support.contact.snsLabel}</span>
          <div class="contact-sns-icons">
            <a href="https://blog.naver.com/dwstorage" target="_blank" rel="noopener" class="sns-icon sns-naver" aria-label={t.support.contact.naverAria}><span>N</span></a>
            <a href="https://www.instagram.com/dw.museum.storage/" target="_blank" rel="noopener" class="sns-icon sns-insta" aria-label={t.support.contact.instaAria}>
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2.5" y="2.5" width="19" height="19" rx="5.5"/><circle cx="12" cy="12" r="4.3"/><circle cx="17.6" cy="6.4" r="1.3" fill="#fff" stroke="none"/></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- FAQ -->
<div class="faq-section">
  <div class="faq-title">{t.faq.title}</div>
  <div class="faq-list">
    {t.faq.items.map((item, i) => (
      <div class="faq-item">
        <div class="faq-q">
          <span class="faq-q-text">{item.q}</span>
          <span class="faq-icon">+</span>
        </div>
        <div class="faq-a"><div class="faq-a-inner">{item.a}
          {item.img && (
            <figure class="faq-figure">
              <img src={item.img} alt={item.imgAlt} style={i === 1 ? 'max-width:480px' : undefined} onerror="this.closest('.faq-figure').style.display='none'" />
              <figcaption>{item.caption}</figcaption>
            </figure>
          )}
        </div></div>
      </div>
    ))}
  </div>
</div>

<style is:global>
/* ─────────────────────────────────────────
   메인 페이지 전용 스타일 (daewon_1.html에서 이식)
   ─ 공통 변수/폰트/.reveal/스크롤바 는 global.css에 있음
   ─ Nav/Footer 스타일은 각 컴포넌트 안에 있음
   ───────────────────────────────────────── */

/* 탭 클릭 시 고정 nav 높이만큼 보정 → 섹션이 nav 바로 아래에 딱 붙음 */
html { scroll-padding-top: var(--nav-h); scroll-behavior: smooth; }

/* ─── HERO ─── */
.hero {
  min-height: 100vh;
  background: var(--c-dark);
  display: grid;
  grid-template-columns: 1fr 1.5fr;
  padding-top: var(--nav-h);
  position: relative;
  overflow: hidden;
}
.hero-left {
  display: flex; flex-direction: column;
  justify-content: center;
  padding: 80px 64px 80px 80px;
  position: relative; z-index: 2;
}
.hero-tag {
  font-family: 'NanumSquare', 'NanumSquareOTF', sans-serif;
  font-size: 11px; color: var(--c-teal2);
  letter-spacing: 0.2em; text-transform: uppercase;
  margin-bottom: 32px;
  opacity: 0; transform: translateY(20px);
  animation: fadeUp 0.8s var(--ease) 0.3s forwards;
}
.hero-h1 {
  font-family: 'Barlow Condensed', 'NanumSquare', 'NanumSquareOTF', sans-serif;
  font-size: clamp(64px, 7vw, 110px);
  font-weight: 800;
  line-height: 0.92;
  letter-spacing: -0.01em;
  color: var(--c-white);
  text-transform: uppercase;
  margin-bottom: 32px;
}
.hero-h1 .line {
  display: block; overflow: hidden;
}
.hero-h1 .line span {
  display: block;
  opacity: 0; transform: translateY(100%);
  animation: slideUp 0.9s var(--ease) forwards;
}
.hero-h1 .line:nth-child(1) span { animation-delay: 0.5s; }
.hero-h1 .line:nth-child(2) span { animation-delay: 0.65s; color: var(--c-teal2); }
.hero-h1 .line:nth-child(3) span { animation-delay: 0.8s; }
.hero-sub {
  font-size: 15px; font-weight: 300; line-height: 1.75;
  color: rgba(255,255,255,0.5);
  max-width: 400px; margin-bottom: 48px;
  opacity: 0; transform: translateY(20px);
  animation: fadeUp 0.8s var(--ease) 1.1s forwards;
}
.hero-btns {
  display: flex; gap: 14px;
  opacity: 0; transform: translateY(20px);
  animation: fadeUp 0.8s var(--ease) 1.3s forwards;
}
.btn-primary {
  font-family: 'Barlow Condensed', 'NanumSquare', 'NanumSquareOTF', sans-serif;
  font-size: 14px; font-weight: 700; letter-spacing: 0.1em;
  text-transform: uppercase; text-decoration: none;
  padding: 14px 32px; border-radius: 4px;
  background: var(--c-teal2); color: var(--c-dark);
  transition: all 0.25s; display: inline-block;
}
.btn-primary:hover { background: var(--c-teal); transform: translateY(-2px); }
.btn-ghost {
  font-family: 'Barlow Condensed', 'NanumSquare', 'NanumSquareOTF', sans-serif;
  font-size: 14px; font-weight: 600; letter-spacing: 0.1em;
  text-transform: uppercase; text-decoration: none;
  padding: 14px 32px; border-radius: 4px;
  border: 1px solid rgba(255,255,255,0.2); color: rgba(255,255,255,0.7);
  transition: all 0.25s; display: inline-block;
}
.btn-ghost:hover { border-color: var(--c-teal2); color: var(--c-teal2); }
.hero-stats {
  position: absolute; bottom: 48px; left: 80px;
  display: flex; gap: 48px;
  opacity: 0; animation: fadeUp 0.8s var(--ease) 1.5s forwards;
}
.hero-stat-num {
  font-family: 'Barlow Condensed', 'NanumSquare', 'NanumSquareOTF', sans-serif;
  font-size: 36px; font-weight: 700; color: var(--c-white);
  line-height: 1;
}
.hero-stat-num span { color: var(--c-teal2); font-size: 20px; }
.hero-stat-label {
  font-size: 11px; color: rgba(255,255,255,0.4);
  letter-spacing: 0.1em; margin-top: 4px;
}

.hero-right {
  position: relative; overflow: hidden;
}
.hero-grid {
  position: absolute; inset: 0;
}
.hero-img {
  background: #2a342a;
  overflow: hidden; position: absolute; inset: 0;
  opacity: 0; transition: opacity 1.8s ease-in-out;
}
.hero-img.active { opacity: 1; }
.hero-img:nth-child(even) .hero-img-inner { animation-direction: alternate-reverse; }
@keyframes heroKen { from { transform: scale(1) translateX(0); } to { transform: scale(1.09) translateX(-1.5%); } }
@media (prefers-reduced-motion: reduce) { .hero-img-inner { animation: none; } }
.hero-dots {
  position: absolute; bottom: 22px; left: 0; right: 0; z-index: 5;
  display: flex; justify-content: center; gap: 9px;
}
.hero-dot {
  width: 9px; height: 9px; border-radius: 50%;
  background: rgba(255,255,255,0.35); border: none; padding: 0; cursor: pointer;
  transition: all 0.3s var(--ease);
}
.hero-dot:hover { background: rgba(255,255,255,0.65); }
.hero-dot.active { background: var(--c-teal2); width: 24px; border-radius: 5px; }
.hero-img::before {
  content: attr(data-label);
  position: absolute; bottom: 16px; left: 20px; z-index: 2;
  font-family: 'NanumSquare', 'NanumSquareOTF', sans-serif;
  font-size: 10px; color: rgba(255,255,255,0.5);
  letter-spacing: 0.15em; text-transform: uppercase;
}
.hero-img::after {
  content: ''; position: absolute; inset: 0;
  background: linear-gradient(to bottom, rgba(0,0,0,0) 40%, rgba(0,0,0,0.55) 100%);
  pointer-events: none;
}
.hero-img-inner {
  width: 100%; height: 100%;
  background: linear-gradient(135deg, #263326 0%, #1e2e1e 50%, #162316 100%);
  background-size: cover; background-position: center;
  transition: transform 6s ease;
  animation: heroKen 16s ease-in-out infinite alternate;
}
.hero-img:hover .hero-img-inner { transform: scale(1.04); }
.hero-overlay-tag {
  position: absolute; top: 20px; right: 20px; z-index: 3;
  font-family: 'NanumSquare', 'NanumSquareOTF', sans-serif;
  font-size: 11px; font-weight: 600; letter-spacing: 0.15em;
  color: var(--c-teal2); background: rgba(15,20,15,0.78);
  backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
  border: 1px solid rgba(37,196,174,0.55);
  padding: 6px 12px; border-radius: 3px; text-transform: uppercase;
  box-shadow: 0 2px 8px rgba(0,0,0,0.25);
}
.hero-line {
  position: absolute; left: 0; top: 50%;
  width: 3px; height: 80px;
  background: linear-gradient(to bottom, transparent, var(--c-teal2), transparent);
  transform: translateY(-50%);
}

/* grid overlay */
.hero::before {
  content: '';
  position: absolute; inset: 0; z-index: 1; pointer-events: none;
  background-image:
    linear-gradient(rgba(255,255,255,0.015) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,0.015) 1px, transparent 1px);
  background-size: 60px 60px;
}

/* ─── SECTION COMMONS ─── */
.section { padding: 120px 80px; }
.section-tag {
  font-family: 'NanumSquare', 'NanumSquareOTF', sans-serif;
  font-size: 11px; color: var(--c-teal);
  letter-spacing: 0.2em; text-transform: uppercase;
  margin-bottom: 20px; display: block;
}
.section-h2 {
  font-family: 'Barlow Condensed', 'NanumSquare', 'NanumSquareOTF', sans-serif;
  font-size: clamp(40px, 5vw, 72px);
  font-weight: 800; text-transform: uppercase;
  line-height: 1.05; letter-spacing: -0.01em;
  margin-bottom: 28px;
}
.reveal {
  opacity: 0; transform: translateY(40px);
  transition: opacity 0.8s var(--ease), transform 0.8s var(--ease);
}
.reveal.visible { opacity: 1; transform: none; }

/* ─── OUR STORY ─── */
.story { background: var(--c-white); }
.story-grid {
  display: grid; grid-template-columns: 1fr 1fr;
  gap: 80px; align-items: start;
}
.story-left .section-h2 { color: var(--c-dark); }
.story-left .section-h2 em { color: var(--c-teal); font-style: normal; }
.story-body {
  font-size: 15px; line-height: 1.9; color: var(--c-muted);
  margin-bottom: 24px;
}
.story-body strong { color: var(--c-text); font-weight: 500; }
.story-sign {
  font-size: 15px; line-height: 1.9;
  color: var(--c-text); font-weight: 500;
  text-align: right; margin-top: 40px;
  padding-top: 24px; border-top: 1px solid var(--c-warm);
}
.story-quote {
  border-left: 3px solid var(--c-teal2);
  padding: 16px 24px;
  background: var(--c-cream);
  border-radius: 0 8px 8px 0;
  margin: 32px 0;
}
.story-quote p {
  font-family: 'Barlow Condensed', 'NanumSquare', 'NanumSquareOTF', sans-serif;
  font-size: 22px; font-weight: 600; line-height: 1.3;
  color: var(--c-olive);
}
.story-quote cite {
  font-family: 'NanumSquare', 'NanumSquareOTF', sans-serif;
  font-size: 10px; color: var(--c-muted);
  letter-spacing: 0.1em; margin-top: 8px; display: block;
}
.story-right { padding-top: 20px; }
.vision-cards {
  display: flex; flex-direction: column; gap: 1px;
  margin-bottom: 40px;
}
.vision-card {
  display: flex; align-items: flex-start; gap: 20px;
  padding: 24px; background: var(--c-cream);
  border-radius: 4px;
  transition: background 0.2s;
}
.vision-card:hover { background: var(--c-warm); }
.vision-num {
  font-family: 'Barlow Condensed', 'NanumSquare', 'NanumSquareOTF', sans-serif;
  font-size: 36px; font-weight: 800;
  color: rgba(31,158,140,0.15); line-height: 1; min-width: 48px;
}
.vision-title {
  font-weight: 700; font-size: 18px; margin-bottom: 8px;
  color: var(--c-text); letter-spacing: -0.01em;
}
.vision-desc { font-size: 13px; color: var(--c-muted); line-height: 1.6; }

.history-strip {
  background: var(--c-dark); border-radius: 12px;
  padding: 28px; overflow: hidden;
}
.history-title {
  font-family: 'Barlow Condensed', 'NanumSquare', 'NanumSquareOTF', sans-serif;
  font-size: 18px; letter-spacing: 0.12em; text-transform: uppercase;
  font-weight: 700;
  color: var(--c-teal2); margin-bottom: 24px;
  display: flex; align-items: baseline; gap: 12px;
}
.history-title-kr {
  font-size: 13px; letter-spacing: 0.05em;
  color: rgba(255,255,255,0.5);
  font-weight: 400; text-transform: none;
}
.history-list { display: flex; flex-direction: column; gap: 10px; }
.history-item {
  display: grid; grid-template-columns: 56px 1fr;
  gap: 16px; align-items: baseline;
}
.history-year {
  font-family: 'Barlow Condensed', 'NanumSquare', 'NanumSquareOTF', sans-serif;
  font-size: 17px; font-weight: 800; color: var(--c-teal2);
  letter-spacing: 0.02em;
}
.history-event { font-size: 12px; color: rgba(255,255,255,0.55); line-height: 1.5; }

/* ─── CERTS MARQUEE ─── */
.cert-strip {
  background: var(--c-olive);
  padding: 20px 0; overflow: hidden;
}
.cert-track {
  display: flex; gap: 0;
  animation: marquee 30s linear infinite;
  white-space: nowrap; width: max-content;
}
.cert-item {
  font-family: 'Barlow Condensed', 'NanumSquare', 'NanumSquareOTF', sans-serif;
  font-size: 13px; font-weight: 600; letter-spacing: 0.12em;
  color: rgba(255,255,255,0.7); text-transform: uppercase;
  padding: 0 32px;
  border-right: 1px solid rgba(255,255,255,0.15);
}
.cert-item span { color: var(--c-teal2); margin-right: 8px; }

/* ─── PRODUCTS ─── */
.products { background: var(--c-cream); }
.products-header {
  display: flex; justify-content: space-between; align-items: flex-end;
  margin-bottom: 60px;
}
.products-header .section-h2 { margin-bottom: 0; }
.product-filter {
  display: flex; gap: 8px; flex-wrap: wrap; justify-content: flex-end;
}
.filter-btn {
  font-family: 'Barlow Condensed', 'NanumSquare', 'NanumSquareOTF', sans-serif;
  font-size: 12px; font-weight: 600; letter-spacing: 0.1em;
  text-transform: uppercase; padding: 7px 16px; border-radius: 4px;
  border: 1px solid var(--c-warm); background: transparent;
  color: var(--c-muted); cursor: pointer; transition: all 0.2s;
  text-decoration: none; display: inline-block;
}
.filter-btn:hover, .filter-btn.active {
  background: var(--c-dark); color: var(--c-teal2); border-color: var(--c-dark);
}
.products-grid {
  display: grid; grid-template-columns: repeat(2, 1fr);
  gap: 2px;
}
.product-card {
  display: block;
  text-decoration: none;
  color: inherit;
  background: var(--c-white);
  position: relative; overflow: hidden;
  cursor: pointer;
  transition: transform 0.3s var(--ease);
}
.product-card:hover { transform: translateY(-4px); z-index: 2; }
.product-card:hover .product-overlay { opacity: 1; }
.product-img {
  height: 280px;
  position: relative;
  background: linear-gradient(135deg, #2a3a2a 0%, #1e2e20 100%);
  display: flex; align-items: center; justify-content: center;
  overflow: hidden;
  transition: transform 0.6s var(--ease);
}
.product-card:hover .product-img { transform: scale(1.03); }
/* 색감 오버레이 (각 카드의 --t1/--t2 그라데이션). 실제 div 레이어 → 호버 시 사라져 사진이 선명해짐 */
.product-tint {
  position: absolute; inset: 0;
  background: linear-gradient(135deg, var(--t1, rgba(20,28,20,0.7)), var(--t2, rgba(14,20,14,0.85)));
  transition: opacity 0.45s var(--ease);
  z-index: 1; pointer-events: none;
}
.product-card:hover .product-tint { opacity: 0; }
.product-img-icon {
  position: relative; z-index: 2;
  font-family: 'Barlow Condensed', 'NanumSquare', 'NanumSquareOTF', sans-serif;
  font-size: 80px; font-weight: 800;
  color: rgba(255,255,255,0.36); line-height: 1;
  letter-spacing: 0.02em;
  text-align: center;
  text-shadow: 0 2px 18px rgba(0,0,0,0.5);
  user-select: none;
  transition: color 0.45s var(--ease), text-shadow 0.45s var(--ease);
}
/* 호버 시 글자는 선명한 흰색으로 유지 (사진 위에서도 잘 보이게) */
.product-card:hover .product-img-icon {
  color: rgba(255,255,255,0.92);
  text-shadow: 0 2px 22px rgba(0,0,0,0.55), 0 0 3px rgba(0,0,0,0.4);
}
.product-img-badge {
  position: absolute; top: 16px; left: 16px;
  font-family: 'NanumSquare', 'NanumSquareOTF', sans-serif;
  font-size: 11px; font-weight: 700; letter-spacing: 0.12em;
  color: var(--c-teal2); background: rgba(15,20,15,0.78);
  backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
  border: 1px solid rgba(37,196,174,0.55);
  padding: 6px 12px; border-radius: 3px; text-transform: uppercase;
  box-shadow: 0 2px 8px rgba(0,0,0,0.25);
  z-index: 2;
}
.product-body { padding: 24px 28px 28px; }
.product-cat {
  font-family: 'NanumSquare', 'NanumSquareOTF', sans-serif;
  font-size: 10px; color: var(--c-teal);
  letter-spacing: 0.15em; text-transform: uppercase;
  margin-bottom: 8px; display: block;
}
.product-name {
  font-family: 'Barlow Condensed', 'NanumSquare', 'NanumSquareOTF', sans-serif;
  font-size: 24px; font-weight: 700; color: var(--c-dark);
  line-height: 1.2; margin-bottom: 4px;
}
.product-name-en {
  font-family: 'Barlow Condensed', 'NanumSquare', 'NanumSquareOTF', sans-serif;
  font-size: 13px; font-weight: 500;
  color: var(--c-muted);
  letter-spacing: 0.06em;
  margin-bottom: 14px; display: block;
}
.product-desc { font-size: 13px; color: var(--c-muted); line-height: 1.7; }
.product-tags {
  display: flex; flex-wrap: wrap; gap: 6px; margin-top: 16px;
}
.product-tag {
  font-size: 11px; color: var(--c-olive);
  background: rgba(61,92,56,0.08);
  padding: 3px 10px; border-radius: 20px;
}
.product-tag.tag-hidden { display: none; }
.product-tags.expanded .product-tag.tag-hidden { display: inline-block; }
.product-tag-toggle {
  font-size: 11px; font-weight: 600; color: var(--c-teal);
  background: rgba(31,158,140,0.10);
  padding: 3px 12px; border-radius: 20px;
  border: 1px dashed rgba(31,158,140,0.45);
  cursor: pointer; font-family: inherit;
  transition: background 0.2s, color 0.2s;
}
.product-tag-toggle:hover { background: rgba(31,158,140,0.20); }
.product-overlay {
  position: absolute; inset: 0;
  background: transparent;
  border: 2px solid rgba(37,196,174,0.3);
  opacity: 0; transition: opacity 0.3s;
  pointer-events: none;
}

/* ─── HOW TO USE ─── */
.how {
  background: var(--c-dark);
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.how .section-tag { color: var(--c-teal2); }
.how .section-h2 { color: var(--c-white); }

/* 설치 사례 — How to Use 아래, 한 화면을 따로 차지하는 별도 화면 */
.cases-section {
  border-top: 1px solid rgba(255,255,255,0.08);
}
.how-intro {
  font-size: 15px; line-height: 1.9; color: rgba(255,255,255,0.5);
  max-width: 560px; margin-bottom: 64px;
}
.how-grid {
  display: grid; grid-template-columns: repeat(4,1fr);
  gap: 2px; margin-bottom: 80px;
}
.how-card {
  display: block;
  text-decoration: none;
  color: inherit;
  cursor: pointer;
  background: rgba(255,255,255,0.03);
  border: 1px solid rgba(255,255,255,0.06);
  padding: 32px 24px;
  transition: background 0.2s, border-color 0.2s;
}
.how-card:hover {
  background: rgba(37,196,174,0.07);
  border-color: rgba(37,196,174,0.25);
}
.how-num {
  font-family: 'Barlow Condensed', 'NanumSquare', 'NanumSquareOTF', sans-serif;
  font-size: 68px; font-weight: 600;
  color: rgba(37,196,174,0.38); line-height: 1;
  margin-bottom: 16px;
  letter-spacing: -0.02em;
  transition: color 0.25s;
}
.how-card:hover .how-num {
  color: rgba(37,196,174,0.7);
}
.how-title {
  font-family: 'Barlow Condensed', 'NanumSquare', 'NanumSquareOTF', sans-serif;
  font-size: 22px; font-weight: 700; color: var(--c-white);
  text-transform: uppercase; letter-spacing: 0.05em;
  margin-bottom: 12px;
}
.how-desc { font-size: 13px; color: rgba(255,255,255,0.45); line-height: 1.7; }
.how-cta {
  display: inline-block;
  margin-top: 18px;
  font-family: 'Barlow Condensed', 'NanumSquare', 'NanumSquareOTF', sans-serif;
  font-size: 13px; font-weight: 600;
  letter-spacing: 0.08em;
  color: rgba(37,196,174,0.55);
  transition: color 0.25s, transform 0.25s;
}
.how-card:hover .how-cta {
  color: rgba(37,196,174,1);
  transform: translateX(4px);
}

.use-cases {
  display: grid; grid-template-columns: repeat(5, 1fr);
  gap: 2px;
}
.use-case {
  background: rgba(255,255,255,0.03);
  border: 1px solid rgba(255,255,255,0.06);
  padding: 56px 24px; text-align: center;
  min-height: 240px;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  transition: all 0.25s;
}
.use-case:hover {
  background: rgba(37,196,174,0.1);
  border-color: rgba(37,196,174,0.3);
  transform: translateY(-4px);
}
.use-case-icon {
  width: 64px; height: 64px;
  margin: 0 auto 20px;
  color: rgba(255,255,255,0.78);
  transition: color 0.25s, transform 0.25s;
}
.use-case-icon svg { width: 100%; height: 100%; display: block; }
.use-case:hover .use-case-icon {
  color: var(--c-teal2);
  transform: translateY(-2px);
}
.use-case-name {
  font-family: 'Barlow Condensed', 'NanumSquare', 'NanumSquareOTF', sans-serif;
  font-size: 21px; font-weight: 700; color: var(--c-white);
  text-transform: uppercase; letter-spacing: 0.05em;
}

/* ─── 설치 사례 헤더 ─── */
.cases-header {
  margin-top: 24px;
  margin-bottom: 28px;
  padding-left: 4px;
}
.cases-eyebrow {
  font-family: 'NanumSquare', 'NanumSquareOTF', sans-serif;
  font-size: 11px; color: var(--c-teal2);
  letter-spacing: 0.2em; text-transform: uppercase;
  margin-bottom: 10px; display: block;
}
.cases-title {
  font-family: 'Barlow Condensed', 'NanumSquare', 'NanumSquareOTF', sans-serif;
  font-size: 28px; font-weight: 800;
  color: var(--c-white);
  text-transform: uppercase; letter-spacing: 0.02em;
  margin-bottom: 8px;
  line-height: 1.1;
}
.cases-sub {
  font-size: 13px; color: rgba(255,255,255,0.45);
  line-height: 1.6;
}

/* ─── 카드: 활성/비활성 상태 ─── */
.use-case.use-case-active {
  text-decoration: none;
  cursor: pointer;
}
.use-case.use-case-active:hover {
  background: rgba(37,196,174,0.15);
  border-color: rgba(37,196,174,0.5);
}
.use-case.use-case-disabled {
  cursor: not-allowed;
  opacity: 0.4;
}
.use-case.use-case-disabled:hover {
  background: rgba(255,255,255,0.03);
  border-color: rgba(255,255,255,0.06);
  transform: none;
}
.use-case.use-case-disabled:hover .use-case-icon {
  color: rgba(255,255,255,0.78);
  transform: none;
}

.use-case-status {
  display: block;
  font-family: 'NanumSquare', 'NanumSquareOTF', sans-serif;
  font-size: 10px;
  letter-spacing: 0.12em;
  margin-top: 8px;
  text-transform: uppercase;
  transition: color 0.25s;
}
.use-case-status.status-active {
  color: var(--c-teal2);
}
.use-case-status.status-soon {
  color: rgba(255,255,255,0.4);
}
.use-case.use-case-active:hover .use-case-status.status-active {
  color: var(--c-white);
}

/* ─── BENEFITS ─── */
.benefits {
  background: var(--c-white);
  padding: 80px;
  display: grid; grid-template-columns: repeat(3, 1fr);
  gap: 2px;
}
.benefit {
  padding: 40px 32px;
  border-right: 1px solid var(--c-warm);
  position: relative;
}
.benefit:last-child { border-right: none; }
.benefit-bar {
  height: 3px; width: 40px;
  background: var(--c-teal2);
  margin-bottom: 24px;
  transition: width 0.5s var(--ease);
}
.benefit:hover .benefit-bar { width: 100%; }
.benefit-title {
  font-family: 'Barlow Condensed', 'NanumSquare', 'NanumSquareOTF', sans-serif;
  font-size: 22px; font-weight: 700; color: var(--c-dark);
  text-transform: uppercase; margin-bottom: 12px;
}
.benefit-num {
  font-family: 'Barlow Condensed', 'NanumSquare', 'NanumSquareOTF', sans-serif;
  font-size: 48px; font-weight: 800;
  color: var(--c-teal2); line-height: 1;
  margin-bottom: 8px;
}
.benefit-desc { font-size: 13px; color: var(--c-muted); line-height: 1.6; }

/* ─── SUPPORT ─── */
.support { background: var(--c-cream); }
.support-grid {
  display: grid; grid-template-columns: 1fr 1fr;
  gap: 80px; align-items: start;
}
.support-left .section-h2 em { color: var(--c-teal); font-style: normal; }
.support-cards {
  display: flex; flex-direction: column; gap: 2px;
}
.support-card {
  display: flex; align-items: center; gap: 20px;
  padding: 20px 24px; background: var(--c-white);
  border-radius: 4px; cursor: pointer;
  border: 1px solid transparent;
  transition: all 0.25s;
  text-decoration: none; color: var(--c-text);
}
.support-card:hover {
  border-color: var(--c-teal2);
  background: rgba(37,196,174,0.04);
  transform: translateX(4px);
}
.support-icon {
  width: 44px; height: 44px; border-radius: 8px;
  background: rgba(31,158,140,0.1);
  display: flex; align-items: center; justify-content: center;
  font-size: 20px; flex-shrink: 0;
  transition: background 0.2s;
}
.support-card:hover .support-icon { background: rgba(31,158,140,0.2); }
.support-card-title { font-weight: 500; font-size: 14px; margin-bottom: 2px; }
.support-card-desc { font-size: 12px; color: var(--c-muted); }
.support-arrow {
  margin-left: auto; font-size: 18px; color: var(--c-teal2);
  opacity: 0; transition: opacity 0.2s, transform 0.2s;
}
.support-card:hover .support-arrow { opacity: 1; transform: translateX(4px); }
.contact-card {
  background: var(--c-dark); border-radius: 12px;
  padding: 40px; color: var(--c-white);
  scroll-margin-top: calc(var(--nav-h) + 20px);
}
/* 견적·A/S·대리점 카드 클릭 시 시선 유도 강조 */
.contact-card.flash {
  animation: contactFlash 1.4s var(--ease) 1;
}
@keyframes contactFlash {
  0%   { box-shadow: 0 0 0 0 rgba(37,196,174,0);   transform: translateY(0); }
  12%  { box-shadow: 0 0 0 4px rgba(37,196,174,0.55), 0 0 36px 6px rgba(37,196,174,0.45); transform: translateY(-3px); }
  30%  { box-shadow: 0 0 0 2px rgba(37,196,174,0.25), 0 0 24px 3px rgba(37,196,174,0.2); }
  55%  { box-shadow: 0 0 0 4px rgba(37,196,174,0.4), 0 0 30px 5px rgba(37,196,174,0.35); transform: translateY(-1px); }
  100% { box-shadow: 0 0 0 0 rgba(37,196,174,0);   transform: translateY(0); }
}
/* 준비중 카드 */
.support-card-soon { cursor: default; }
.support-card-soon:hover {
  border-color: rgba(0,0,0,0.06);
  background: var(--c-white);
  transform: none;
}
.support-card-soon .support-card-title,
.support-card-soon .support-card-desc { opacity: 0.7; }
.soon-badge {
  margin-left: auto; flex-shrink: 0;
  font-family: 'NanumSquare', 'NanumSquareOTF', sans-serif;
  font-size: 11px; font-weight: 700; letter-spacing: 0.04em;
  color: var(--c-muted);
  background: rgba(0,0,0,0.05);
  border: 1px solid rgba(0,0,0,0.08);
  padding: 4px 10px; border-radius: 999px;
  white-space: nowrap;
}
/* 준비중 안내 토스트 */
.soon-toast {
  position: fixed; left: 50%; bottom: 32px;
  transform: translateX(-50%) translateY(16px);
  max-width: calc(100vw - 40px);
  background: var(--c-dark); color: var(--c-white);
  border: 1px solid rgba(37,196,174,0.45);
  padding: 14px 22px; border-radius: 12px;
  font-size: 14px; line-height: 1.5;
  box-shadow: 0 12px 40px rgba(0,0,0,0.35);
  opacity: 0; pointer-events: none; z-index: 2000;
  transition: opacity 0.3s var(--ease), transform 0.3s var(--ease);
}
.soon-toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }
.contact-title {
  font-family: 'Barlow Condensed', 'NanumSquare', 'NanumSquareOTF', sans-serif;
  font-size: 32px; font-weight: 800; text-transform: uppercase;
  margin-bottom: 8px; color: var(--c-white);
}
.contact-sub { font-size: 13px; color: rgba(255,255,255,0.5); margin-bottom: 32px; }
.contact-info { display: flex; flex-direction: column; gap: 14px; margin-bottom: 32px; }
.contact-row {
  display: flex; align-items: center; gap: 12px;
}
.contact-label {
  font-family: 'NanumSquare', 'NanumSquareOTF', sans-serif;
  font-size: 10px; letter-spacing: 0.15em;
  color: var(--c-teal2); width: 60px; flex-shrink: 0;
  text-transform: uppercase;
}
.contact-value { font-size: 14px; color: rgba(255,255,255,0.75); }
.contact-sns { display: flex; align-items: center; gap: 14px; margin-top: 22px; }
.contact-sns-label {
  font-family: 'NanumSquare', 'NanumSquareOTF', sans-serif;
  font-size: 10px; letter-spacing: 0.15em; text-transform: uppercase; color: var(--c-teal2);
}
.contact-sns-icons { display: flex; gap: 14px; }
.sns-icon {
  width: 56px; height: 56px; border-radius: 14px;
  display: flex; align-items: center; justify-content: center;
  text-decoration: none; transition: transform 0.2s, opacity 0.2s;
}
.sns-icon:hover { transform: translateY(-2px); opacity: 0.88; }
.sns-naver { background: #03C75A; }
.sns-naver span { font-family: 'Barlow Condensed', 'NanumSquare', sans-serif; font-size: 33px; font-weight: 800; color: #fff; line-height: 1; }
.sns-insta { background: radial-gradient(circle at 30% 107%, #fdf497 0%, #fdf497 5%, #fd5949 45%, #d6249f 60%, #285AEB 90%); }
.kakao-btn {
  display: flex; align-items: center; gap: 10px;
  background: #FEE500; color: #191919;
  border: none; padding: 14px 24px; border-radius: 8px;
  font-family: 'Barlow Condensed', 'NanumSquare', 'NanumSquareOTF', sans-serif;
  font-size: 15px; font-weight: 700; letter-spacing: 0.05em;
  cursor: pointer; width: 100%; justify-content: center;
  transition: opacity 0.2s, transform 0.2s;
  text-decoration: none;
}
.kakao-btn:hover { opacity: 0.9; transform: translateY(-1px); color: #191919; }

/* ─── FAQ ─── */
.faq-section { padding: 0 80px 120px; background: var(--c-cream); }
.faq-title {
  font-family: 'Barlow Condensed', 'NanumSquare', 'NanumSquareOTF', sans-serif;
  font-size: 14px; font-weight: 600; letter-spacing: 0.12em;
  text-transform: uppercase; color: var(--c-teal);
  margin-bottom: 28px;
}
.faq-list { display: flex; flex-direction: column; gap: 2px; }
.faq-item {
  background: var(--c-white); border-radius: 4px;
  overflow: hidden;
}
.faq-q {
  display: flex; justify-content: space-between; align-items: center;
  padding: 20px 24px; cursor: pointer;
  transition: background 0.2s;
}
.faq-q:hover { background: var(--c-cream); }
.faq-q-text { font-weight: 500; font-size: 14px; color: var(--c-text); }
.faq-icon {
  font-family: 'Barlow Condensed', 'NanumSquare', 'NanumSquareOTF', sans-serif;
  font-size: 22px; color: var(--c-teal2);
  transition: transform 0.3s; flex-shrink: 0; margin-left: 16px;
}
.faq-item.open .faq-icon { transform: rotate(45deg); }
.faq-a {
  max-height: 0; overflow: hidden;
  transition: max-height 0.4s var(--ease);
}
.faq-a-inner {
  padding: 0 24px 20px;
  font-size: 13px; color: var(--c-muted); line-height: 1.8;
  border-top: 1px solid var(--c-cream);
  padding-top: 16px; margin-top: 0;
}
.faq-figure { margin: 16px 0 0; }
.faq-a-inner img {
  display: block; width: 100%; max-width: 360px;
  height: auto; border-radius: 6px;
  border: 1px solid var(--c-cream);
}
.faq-a-inner figcaption {
  font-size: 12px; color: var(--c-muted);
  margin-top: 8px; line-height: 1.5;
}
.faq-item.open .faq-a { max-height: 1500px; }

/* ─── ANIMATIONS ─── */
@keyframes fadeUp {
  to { opacity: 1; transform: translateY(0); }
}
@keyframes slideUp {
  to { opacity: 1; transform: translateY(0); }
}
@keyframes marquee {
  from { transform: translateX(0); }
  to { transform: translateX(-50%); }
}
@media (max-width: 768px) {
  /* ── NAV ── */
  nav { padding: 0 20px; }
  .nav-links, .nav-right { display: none; }
  .nav-hamburger { display: flex; }
  .mobile-menu { display: block; }

  /* ── HOW / 설치 사례: 모바일은 자연 높이 ── */
  .how { min-height: auto; display: block; }

  /* ── HERO ── */
  .hero {
    grid-template-columns: 1fr;
    min-height: auto;
    padding-top: var(--nav-h);
  }
  .hero-left {
    padding: 48px 24px 40px;
    order: 1;
  }
  .hero-tag { font-size: 9px; margin-bottom: 20px; letter-spacing: 0.15em; }
  .hero-h1 { font-size: clamp(52px, 14vw, 80px); margin-bottom: 20px; }
  .hero-sub { font-size: 14px; margin-bottom: 32px; }
  .hero-btns { flex-direction: column; gap: 10px; }
  .btn-primary, .btn-ghost { text-align: center; padding: 13px 24px; }
  .hero-stats {
    position: static; margin-top: 40px;
    gap: 28px; flex-wrap: wrap;
    animation: fadeUp 0.8s var(--ease) 1.5s forwards;
  }
  .hero-stat-num { font-size: 28px; }
  .hero-right { height: 62vh; min-height: 380px; order: 0; }
  .hero-grid { position: relative; height: 100%; inset: auto; display: block; gap: 0; }
  /* 모바일: 점과 사진 라벨이 같은 높이에서 겹치지 않게 점을 위로 올림 + 라벨 폭 제한 */
  .hero-dots { bottom: 60px; }
  .hero-img::before { max-width: calc(100% - 40px); }

  /* ── SECTION COMMON ── */
  .section { padding: 64px 24px; }
  .section-h2 { font-size: clamp(36px, 10vw, 52px); }

  /* ── STORY ── */
  .story-grid { grid-template-columns: 1fr; gap: 40px; }
  .story-quote p { font-size: 18px; }

  /* ── CERT MARQUEE ── */
  .cert-item { padding: 0 20px; font-size: 11px; }

  /* ── PRODUCTS ── */
  .products-header { flex-direction: column; align-items: flex-start; gap: 20px; }
  .product-filter { justify-content: flex-start; }
  .products-grid { grid-template-columns: 1fr; }
  .product-img { height: 200px !important; }

  /* ── BENEFITS ── */
  .benefits {
    padding: 48px 24px;
  }
  .benefit { padding: 28px 16px; }
  .benefit-num { font-size: 36px; }

  /* ── HOW TO USE ── */
  .how-grid { grid-template-columns: 1fr 1fr; }
  .use-cases { grid-template-columns: repeat(3, 1fr); }

  /* ── SUPPORT ── */
  .support-grid { grid-template-columns: 1fr; gap: 40px; }

  /* ── FAQ ── */
  .faq-section { padding: 0 24px 64px; }
  .faq-q { padding: 16px 18px; }
  .faq-q-text { font-size: 13px; }

  /* ── FOOTER ── */
  footer { padding: 48px 24px 32px; }
  .footer-top { grid-template-columns: 1fr 1fr; gap: 32px; }
  .footer-bottom { flex-direction: column; gap: 16px; text-align: center; }
  .footer-badges { flex-wrap: wrap; justify-content: center; }
}

@media (max-width: 480px) {
  /* ── 더 작은 화면 ── */
  .hero-right { height: 54vh; min-height: 320px; }
  .how-grid { grid-template-columns: 1fr; }
  .use-cases { grid-template-columns: repeat(2, 1fr); }
  .benefits { grid-template-columns: 1fr; }
  .benefit { border-right: none !important; }
  .benefit:not(:last-child) { border-bottom: 1px solid var(--c-warm); }
  .footer-top { grid-template-columns: 1fr; }
  .product-filter { gap: 6px; }
  .filter-btn { font-size: 11px; padding: 6px 12px; }
  .hero-stats { gap: 20px; }
}

</style>

<script>
// 메인 페이지 인터랙션
// (햄버거 메뉴와 스크롤 리빌은 Nav.astro / BaseLayout에서 처리됨)

// FAQ 아코디언 — 내용(사진 포함) 실제 높이에 맞춰 펼침
document.querySelectorAll('.faq-q').forEach((q) => {
  q.addEventListener('click', () => {
    const item = q.closest('.faq-item');
    if (!item) return;
    const wasOpen = item.classList.contains('open');
    document.querySelectorAll('.faq-item').forEach(i => {
      i.classList.remove('open');
      const a = i.querySelector('.faq-a');
      if (a) a.style.maxHeight = null;
    });
    if (!wasOpen) {
      item.classList.add('open');
      const a = item.querySelector('.faq-a');
      if (a) a.style.maxHeight = a.scrollHeight + 'px';
    }
  });
});

// 답변 속 사진이 뒤늦게 로드되면 펼쳐진 항목 높이를 다시 맞춤
document.querySelectorAll('.faq-a img').forEach((img) => {
  img.addEventListener('load', () => {
    const item = img.closest('.faq-item');
    const a = img.closest('.faq-a');
    if (item && a && item.classList.contains('open')) {
      a.style.maxHeight = a.scrollHeight + 'px';
    }
  });
});

// 제품 필터 (시각적 활성 표시만; 실제 필터링은 추후 동적 데이터 연결 시 구현)
document.querySelectorAll('.filter-btn').forEach((btn) => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
  });
});

// 제품 태그 "+ 더 보기" 토글
document.querySelectorAll('.product-tag-toggle').forEach((btn) => {
  btn.addEventListener('click', (e) => {
    e.preventDefault();   // 부모 카드 링크(<a>) 이동 방지
    e.stopPropagation();
    const tags = btn.closest('.product-tags');
    if (!tags) return;
    const isExpanded = tags.classList.toggle('expanded');
    btn.textContent = isExpanded ? ((btn as HTMLElement).dataset.less || '') : ((btn as HTMLElement).dataset.more || '');
  });
});

// Stagger reveal delays (카드들을 순차적으로 등장시키기)
document.querySelectorAll('.how-card, .benefit, .use-case, .vision-card').forEach((el, i) => {
  (el as HTMLElement).style.transitionDelay = `${i * 0.1}s`;
});

// 견적·A/S·대리점 카드 클릭 → Contact Us 상자로 시선 유도 (스크롤은 href="#contact"가 담당)
const contactCard = document.getElementById('contact');
document.querySelectorAll('.js-flash').forEach((el) => {
  el.addEventListener('click', () => {
    if (!contactCard) return;
    contactCard.classList.remove('flash');
    void (contactCard as HTMLElement).offsetWidth; // 리플로우 → 연속 클릭에도 애니메이션 재시작
    contactCard.classList.add('flash');
  });
});
if (contactCard) {
  contactCard.addEventListener('animationend', () => contactCard.classList.remove('flash'));
}

// 준비중 카드(카탈로그·DW MALL) 클릭 → 안내 토스트 (맨 위로 튀지 않음)
let soonToast: HTMLElement | null = null;
let soonTimer = 0;
function showSoonToast(msg: string) {
  if (!soonToast) {
    soonToast = document.createElement('div');
    soonToast.className = 'soon-toast';
    document.body.appendChild(soonToast);
  }
  soonToast.textContent = msg;
  void soonToast.offsetWidth;
  soonToast.classList.add('show');
  window.clearTimeout(soonTimer);
  soonTimer = window.setTimeout(() => { if (soonToast) soonToast.classList.remove('show'); }, 2800);
}
document.querySelectorAll('.js-soon').forEach((el) => {
  const handler = () => showSoonToast((el as HTMLElement).dataset.soonMsg || '');
  el.addEventListener('click', handler);
  el.addEventListener('keydown', (e) => {
    const ke = e as KeyboardEvent;
    if (ke.key === 'Enter' || ke.key === ' ') { ke.preventDefault(); handler(); }
  });
});
</script>

<script>
  const heroSlides = Array.from(document.querySelectorAll('.hero-img'));
  const heroDotsWrap = document.getElementById('heroDots');
  if (heroSlides.length && heroDotsWrap) {
    const dotTpl = heroDotsWrap.dataset.dotLabel || '{n}';
    let heroIdx = Math.max(0, heroSlides.findIndex(s => s.classList.contains('active')));
    let heroTimer = null;
    const heroDotEls = [];
    function heroShow(i) {
      heroIdx = i;
      heroSlides.forEach((s, j) => s.classList.toggle('active', j === i));
      heroDotEls.forEach((d, j) => d.classList.toggle('active', j === i));
    }
    function heroStart() { heroTimer = setInterval(() => heroShow((heroIdx + 1) % heroSlides.length), 5500); }
    function heroGo(i) { heroShow(i); clearInterval(heroTimer); heroStart(); }
    heroSlides.forEach((_, i) => {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'hero-dot' + (i === heroIdx ? ' active' : '');
      b.setAttribute('aria-label', dotTpl.replace('{n}', String(i + 1)));
      b.addEventListener('click', () => heroGo(i));
      heroDotsWrap.appendChild(b);
      heroDotEls.push(b);
    });
    heroStart();
  }
</script>
