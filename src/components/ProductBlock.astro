---
// 단일 제품 블록 (제품 1건을 렌더링) — 설치 사례 CaseBlock과 동일한 디자인 언어
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import { slugMap } from '../lib/categories';

interface Props {
  entry: CollectionEntry<'products'>;
  productNum: number;  // 제품군 안에서의 표시 번호
}
const { entry, productNum } = Astro.props;
const { data } = entry;
const { Content } = await entry.render();

// ─── 관련 설치 사례 자동 매칭 ───
// 제품의 related_case_categories 와 카테고리가 겹치는 "발행된" 사례를 끌어옵니다.
let relatedCases: { title: string; slug: string; category: string; categorySlug: string }[] = [];
if (data.related_case_categories.length > 0) {
  const allCases = await getCollection('cases', (c) => c.data.published);
  const seen = new Set<string>();
  for (const c of allCases) {
    const match = c.data.categories.find((cat) => data.related_case_categories.includes(cat));
    if (match && !seen.has(c.slug)) {
      seen.add(c.slug);
      relatedCases.push({
        title: c.data.title.trim(),
        slug: c.slug,
        category: match,
        categorySlug: slugMap[match],
      });
    }
  }
  relatedCases = relatedCases.slice(0, 6);
}
---

<article class="product" id={entry.slug}>
  <header class="product-head reveal">
    <div class="product-head-left">
      <div class="product-num">
        <span>Product {String(productNum).padStart(2, '0')}</span>
        {data.badge && <span class="product-badge">{data.badge}</span>}
      </div>
      <h2 class="product-name-h">{data.name}</h2>
      {data.name_en && <div class="product-name-en">{data.name_en}</div>}
    </div>
    <p class="product-tagline">{data.subtitle}</p>
  </header>

  <!-- Hero 이미지 -->
  <div class="product-hero-img reveal">
    <img src={data.hero_image} alt={data.hero_image_alt || data.name} loading="lazy" />
  </div>

  <!-- Meta 3컬럼: 분류 / 제품군 / 라인업 -->
  <div class="product-meta reveal">
    <div class="product-meta-item">
      <div class="product-meta-label">Category</div>
      <div class="product-meta-value">{data.category_label || '—'}</div>
    </div>
    <div class="product-meta-item">
      <div class="product-meta-label">Family</div>
      <div class="product-meta-value">{data.families.join(' · ')}</div>
    </div>
    <div class="product-meta-item">
      <div class="product-meta-label">Lineup</div>
      <div class="product-meta-value">{data.lineup.length > 0 ? `${data.lineup.length}종` : '—'}</div>
    </div>
  </div>

  <!-- Overview (마크다운 본문) + Spec card -->
  <div class="product-overview reveal">
    <div class="product-overview-body">
      <Content />
      {data.quote && (
        <div class="product-overview-quote">
          <p>"{data.quote}"</p>
        </div>
      )}
    </div>

    {data.specs.length > 0 && (
      <aside class="spec-card">
        <div class="spec-card-title">Specifications</div>
        <ul class="spec-list">
          {data.specs.map(s => (
            <li class="spec-row">
              <span class="spec-key">{s.key}</span>
              <span class="spec-val" set:html={s.value.replace(/\//g, '<br/>')} />
            </li>
          ))}
        </ul>
      </aside>
    )}
  </div>

  <!-- Lineup (제품 라인업 칩) -->
  {data.lineup.length > 0 && (
    <div class="product-lineup reveal">
      <div class="product-lineup-title">Lineup — 제품 라인업</div>
      <div class="lineup-chips">
        {data.lineup.map(item => <span class="lineup-chip">{item}</span>)}
      </div>
    </div>
  )}

  <!-- Key Features -->
  {data.features.length > 0 && (
    <div class="product-features reveal">
      {data.features.map((f, i) => (
        <div class="feature-card">
          <div class="feature-num">{String(i + 1).padStart(2, '0')}</div>
          <h3 class="feature-title">{f.title}</h3>
          <p class="feature-desc">{f.description}</p>
        </div>
      ))}
    </div>
  )}

  <!-- Gallery -->
  {data.gallery.length > 0 && (
    <div class="product-gallery reveal">
      {data.gallery.map((g, i) => (
        <div class:list={['gallery-item', i === 0 && 'tall']}>
          <img src={g.image} alt={g.caption} loading="lazy" />
          <div class="gallery-caption">
            <div class="gallery-caption-label">{String(i + 1).padStart(2, '0')} — {g.label}</div>
            <div class="gallery-caption-text">{g.caption}</div>
          </div>
        </div>
      ))}
    </div>
  )}

  <!-- 관련 설치 사례 -->
  {relatedCases.length > 0 && (
    <div class="product-related reveal">
      <div class="product-related-title">이 제품이 설치된 사례</div>
      <div class="related-grid">
        {relatedCases.map(rc => (
          <a class="related-card" href={`/cases/${rc.categorySlug}#${rc.slug}`}>
            <span class="related-cat">{rc.category}</span>
            <span class="related-name">{rc.title}</span>
            <span class="related-arrow">→</span>
          </a>
        ))}
      </div>
    </div>
  )}
</article>

<style>
.product {
  margin-bottom: 100px;
  scroll-margin-top: calc(var(--nav-h) + var(--tabs-h, 0px) + 20px);
}
.product:last-child { margin-bottom: 0; }

.product-head {
  display: flex; align-items: flex-end; justify-content: space-between;
  gap: 32px; margin-bottom: 32px; flex-wrap: wrap;
}
.product-head-left { flex: 1; min-width: 280px; }
.product-num {
  font-family: 'Barlow Condensed', sans-serif;
  font-size: 13px; font-weight: 700;
  letter-spacing: 0.2em; text-transform: uppercase;
  color: var(--c-teal);
  margin-bottom: 12px;
  display: flex; align-items: center; gap: 14px;
}
.product-num > span:first-child {
  display: flex; align-items: center; gap: 12px;
}
.product-num > span:first-child::before {
  content: ''; width: 32px; height: 1px; background: var(--c-teal);
}
.product-badge {
  font-family: 'Barlow Condensed', sans-serif;
  font-size: 11px; font-weight: 700;
  letter-spacing: 0.12em;
  color: var(--c-dark);
  background: var(--c-teal2);
  padding: 3px 10px; border-radius: 999px;
}
.product-name-h {
  font-family: 'Barlow Condensed', 'NanumSquare', sans-serif;
  font-size: clamp(28px, 3.4vw, 44px);
  font-weight: 800; line-height: 1.1;
  color: var(--c-dark); letter-spacing: -0.01em;
}
.product-name-en {
  font-family: 'Barlow Condensed', sans-serif;
  font-size: 14px; font-weight: 600; letter-spacing: 0.1em;
  text-transform: uppercase; color: var(--c-muted);
  margin-top: 6px;
}
.product-tagline {
  font-size: 14px; line-height: 1.7;
  color: var(--c-muted);
  max-width: 380px; text-align: right;
}

.product-hero-img {
  width: 100%; aspect-ratio: 16 / 9;
  overflow: hidden; background: var(--c-dark);
  margin-bottom: 56px;
}
.product-hero-img img {
  width: 100%; height: 100%; display: block; object-fit: cover;
}

.product-meta {
  display: grid; grid-template-columns: repeat(3, 1fr);
  background: var(--c-white);
  border: 1px solid var(--c-warm);
  margin-bottom: 56px;
}
.product-meta-item {
  padding: 24px 28px;
  border-right: 1px solid var(--c-warm);
}
.product-meta-item:last-child { border-right: none; }
.product-meta-label {
  font-family: 'Barlow Condensed', sans-serif;
  font-size: 11px; font-weight: 700;
  letter-spacing: 0.18em;
  color: var(--c-muted);
  text-transform: uppercase;
  margin-bottom: 8px;
}
.product-meta-value {
  font-size: 14px; color: var(--c-text);
  line-height: 1.5; font-weight: 600;
}

.product-overview {
  display: grid; grid-template-columns: 1.4fr 1fr;
  gap: 64px; align-items: start;
  margin-bottom: 56px;
}
.product-overview-body :global(p) {
  font-size: 15px; line-height: 1.9; color: var(--c-muted);
  margin-bottom: 20px;
}
.product-overview-body :global(p strong) { color: var(--c-text); font-weight: 700; }
.product-overview-quote {
  border-left: 3px solid var(--c-teal2);
  padding: 16px 22px;
  background: var(--c-white);
  margin-top: 24px;
}
.product-overview-quote p {
  font-family: 'Barlow Condensed', 'NanumSquare', sans-serif;
  font-size: 19px; font-weight: 600; line-height: 1.4;
  color: var(--c-olive);
  margin: 0;
}

.spec-card {
  background: var(--c-white);
  border: 1px solid var(--c-warm);
  padding: 28px;
}
.spec-card-title {
  font-family: 'Barlow Condensed', sans-serif;
  font-size: 12px; font-weight: 700;
  letter-spacing: 0.18em; text-transform: uppercase;
  color: var(--c-olive); margin-bottom: 18px;
  padding-bottom: 14px;
  border-bottom: 1px solid var(--c-warm);
}
.spec-list { list-style: none; display: flex; flex-direction: column; gap: 14px; }
.spec-row {
  display: grid; grid-template-columns: 92px 1fr;
  gap: 14px; align-items: start;
}
.spec-key {
  font-size: 11px; letter-spacing: 0.05em;
  color: var(--c-muted); font-weight: 700;
  padding-top: 2px; text-transform: uppercase;
}
.spec-val {
  font-size: 13px; line-height: 1.6;
  color: var(--c-text); font-weight: 500;
}

/* ─── 라인업 칩 ─── */
.product-lineup {
  background: var(--c-white);
  border: 1px solid var(--c-warm);
  padding: 32px 36px;
  margin-bottom: 56px;
}
.product-lineup-title {
  font-family: 'Barlow Condensed', sans-serif;
  font-size: 13px; font-weight: 700;
  letter-spacing: 0.18em; text-transform: uppercase;
  color: var(--c-olive); margin-bottom: 20px;
}
.lineup-chips { display: flex; flex-wrap: wrap; gap: 8px; }
.lineup-chip {
  font-family: 'NanumSquare', sans-serif;
  font-size: 13px; font-weight: 700;
  color: var(--c-text);
  background: var(--c-cream);
  border: 1px solid var(--c-warm);
  padding: 8px 14px; border-radius: 999px;
  line-height: 1;
}

.product-features {
  background: var(--c-dark);
  display: grid; grid-template-columns: repeat(3, 1fr);
  gap: 1px;
  margin-bottom: 56px;
}
.feature-card {
  background: var(--c-dark);
  border: 1px solid rgba(255,255,255,0.06);
  padding: 36px 28px;
  transition: background 0.2s, border-color 0.2s;
}
.feature-card:hover {
  background: rgba(37,196,174,0.07);
  border-color: rgba(37,196,174,0.25);
}
.feature-num {
  font-family: 'Barlow Condensed', sans-serif;
  font-size: 56px; font-weight: 600;
  color: rgba(37,196,174,0.7); line-height: 1;
  margin-bottom: 16px;
  letter-spacing: -0.02em;
}
.feature-card:hover .feature-num { color: var(--c-teal2); }
.feature-title {
  font-family: 'NanumSquare', sans-serif;
  font-size: 17px; font-weight: 700; color: var(--c-white);
  line-height: 1.4; margin-bottom: 12px;
}
.feature-desc {
  font-size: 12.5px; color: rgba(255,255,255,0.55); line-height: 1.85;
}

.product-gallery {
  display: grid;
  grid-template-columns: 1.2fr 1fr;
  grid-template-rows: auto auto;
  gap: 1px;
  background: var(--c-warm);
  margin-bottom: 56px;
}
.gallery-item {
  position: relative; overflow: hidden;
  background: var(--c-dark);
}
.gallery-item img {
  width: 100%; height: 100%; display: block;
  object-fit: cover;
  transition: transform 0.7s var(--ease);
}
.gallery-item:hover img { transform: scale(1.04); }
.gallery-item.tall { grid-row: span 2; }
.gallery-caption {
  position: absolute; bottom: 0; left: 0; right: 0;
  padding: 20px;
  background: linear-gradient(to top, rgba(21,26,20,0.85), transparent);
  color: var(--c-white);
  opacity: 0; transform: translateY(8px);
  transition: opacity 0.3s, transform 0.3s;
}
.gallery-item:hover .gallery-caption { opacity: 1; transform: none; }
.gallery-caption-label {
  font-family: 'Barlow Condensed', sans-serif;
  font-size: 10px; letter-spacing: 0.2em;
  color: var(--c-teal2); margin-bottom: 4px;
  text-transform: uppercase;
}
.gallery-caption-text { font-size: 13px; line-height: 1.4; font-weight: 500; }

/* ─── 관련 설치 사례 ─── */
.product-related {
  background: var(--c-white);
  border: 1px solid var(--c-warm);
  padding: 36px;
}
.product-related-title {
  font-family: 'Barlow Condensed', 'NanumSquare', sans-serif;
  font-size: 16px; font-weight: 700;
  color: var(--c-dark); margin-bottom: 24px;
  padding-bottom: 16px;
  border-bottom: 1px solid var(--c-warm);
}
.related-grid {
  display: grid; grid-template-columns: repeat(2, 1fr);
  gap: 10px;
}
.related-card {
  display: flex; align-items: center; gap: 14px;
  padding: 16px 20px;
  background: var(--c-cream);
  border: 1px solid var(--c-warm);
  border-radius: 6px;
  text-decoration: none;
  transition: border-color 0.2s, background 0.2s, transform 0.2s;
}
.related-card:hover {
  border-color: var(--c-teal2);
  background: rgba(37,196,174,0.04);
  transform: translateX(4px);
}
.related-cat {
  font-family: 'NanumSquare', sans-serif;
  font-size: 10px; font-weight: 700; letter-spacing: 0.05em;
  color: var(--c-teal); background: rgba(37,196,174,0.1);
  padding: 4px 9px; border-radius: 999px; flex-shrink: 0;
}
.related-name {
  font-size: 14px; font-weight: 600; color: var(--c-text);
  line-height: 1.4;
}
.related-arrow {
  margin-left: auto; color: var(--c-teal2); font-size: 18px;
  opacity: 0; transition: opacity 0.2s, transform 0.2s;
}
.related-card:hover .related-arrow { opacity: 1; transform: translateX(3px); }

@media (max-width: 1100px) {
  .product-features { grid-template-columns: 1fr; }
  .product-overview { grid-template-columns: 1fr; gap: 36px; }
  .product-meta { grid-template-columns: 1fr; }
  .product-meta-item { border-right: none; border-bottom: 1px solid var(--c-warm); }
  .product-meta-item:last-child { border-bottom: none; }
  .related-grid { grid-template-columns: 1fr; }
}

@media (max-width: 768px) {
  .product { margin-bottom: 64px; }
  .product-head { flex-direction: column; align-items: flex-start; gap: 16px; }
  .product-tagline { text-align: left; }
  .product-name-h { font-size: 28px; }
  .product-hero-img { aspect-ratio: 4 / 3; margin-bottom: 36px; }
  .product-overview { gap: 32px; margin-bottom: 36px; }
  .product-lineup { padding: 24px; margin-bottom: 36px; }
  .product-features { margin-bottom: 36px; }
  .product-gallery { grid-template-columns: 1fr; margin-bottom: 36px; }
  .gallery-item.tall { grid-row: auto; }
  .gallery-item img { aspect-ratio: 4 / 3; }
  .product-related { padding: 24px; }
}
</style>
