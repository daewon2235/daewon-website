---
// 동적 라우트: /products/mobile-rack, /products/museum, ...
// 한 파일로 4개 제품군 페이지를 모두 처리합니다.
// (설치 사례의 src/pages/cases/[category].astro 와 동일 구조)
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductTabs from '../../components/ProductTabs.astro';
import ProductBlock from '../../components/ProductBlock.astro';
import { familyMap, familyMeta, familyEnLabelMap } from '../../lib/products';

// 정적 경로 생성 (4개 제품군 페이지를 빌드 시 미리 생성)
export async function getStaticPaths() {
  return Object.keys(familyMap).map(slug => ({
    params: { family: slug },
  }));
}

const { family: slugParam } = Astro.params;
const familyName = familyMap[slugParam as string];
if (!familyName) {
  return Astro.redirect('/');
}

const meta = familyMeta[familyName];
const enLabel = familyEnLabelMap[familyName];

const allProducts = await getCollection('products', ({ data }) =>
  data.published && data.families.includes(familyName)
);
// 정렬: display_order(작을수록 먼저) → 없으면 발행일 최신순
const products = allProducts.sort((a, b) => {
  const ao = a.data.display_order ?? Number.POSITIVE_INFINITY;
  const bo = b.data.display_order ?? Number.POSITIVE_INFINITY;
  if (ao !== bo) return ao - bo;
  return b.data.published_date.valueOf() - a.data.published_date.valueOf();
});

const pageTitle = `${meta.title} ${meta.emTitle} — (주)대원모빌랙`;
---

<BaseLayout title={pageTitle} description={meta.subtitle}>
  <section class="page-header">
    <div class="page-header-inner">
      <div class="breadcrumb">
        <a href="/">Home</a>
        <span class="sep">/</span>
        <a href="/#products">Products</a>
        <span class="sep">/</span>
        <span class="current">{meta.title} · {enLabel}</span>
      </div>
      <span class="page-tag">Product Lineup</span>
      <h1 class="page-title">{meta.title} <em>{meta.emTitle}</em></h1>
      <p class="page-subtitle">{meta.subtitle}</p>
    </div>
  </section>

  <ProductTabs active={familyName} />

  <section class="products-wrap">
    <div class="products-inner">
      <div class="products-count reveal">
        <div class="products-count-num">
          <strong>{String(products.length).padStart(2, '0')}</strong>개의 {familyName} 제품
        </div>
        <div class="products-sort">기본 순</div>
      </div>

      {products.length > 1 && (
        <div class="product-thumbs reveal">
          <button class="thumb-nav thumb-nav-prev" type="button" aria-label="이전 제품 보기" hidden>‹</button>
          <div class="product-thumbs-track" role="tablist" aria-label="제품 선택">
            {products.map((entry, i) => (
              <button
                class:list={['product-thumb', i === 0 && 'active']}
                type="button"
                role="tab"
                aria-selected={i === 0 ? 'true' : 'false'}
                data-target={entry.slug}
              >
                {entry.data.name}
              </button>
            ))}
          </div>
          <button class="thumb-nav thumb-nav-next" type="button" aria-label="다음 제품 보기" hidden>›</button>
        </div>
      )}

      {products.length > 0 ? (
        <div class="product-stage">
          {products.map((entry, i) => (
            <div class:list={['product-slot', i === 0 && 'active']} data-product={entry.slug}>
              <ProductBlock entry={entry} productNum={i + 1} />
            </div>
          ))}
        </div>
      ) : (
        <div class="product-empty reveal">
          <div class="product-empty-tag">Coming Soon</div>
          <p class="product-empty-text">이 제품군의 제품이 곧 업데이트됩니다.</p>
        </div>
      )}
    </div>
  </section>

  <section class="cta">
    <div class="cta-inner">
      <div class="cta-tag">Next Step</div>
      <h2 class="cta-title">{meta.title} 도입을 검토 중이신가요?</h2>
      <p class="cta-desc">
        공간·용도·예산에 맞춘 1:1 맞춤 설계부터 제작·시공·유지보수까지.<br>
        대원모빌랙이 40년의 경험으로 함께합니다.
      </p>
      <div class="cta-btns">
        <a href="/#support" class="btn-primary">견적 문의하기</a>
        <a href="/#products" class="btn-ghost">다른 제품군 보기</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
.page-header {
  background: var(--c-dark);
  padding: calc(var(--nav-h) + 64px) 80px 56px;
  position: relative; overflow: hidden;
}
.page-header::before {
  content: '';
  position: absolute; inset: 0; pointer-events: none;
  background-image:
    linear-gradient(rgba(255,255,255,0.015) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,0.015) 1px, transparent 1px);
  background-size: 60px 60px;
}
.page-header-inner { position: relative; z-index: 2; max-width: 1400px; margin: 0 auto; }
.breadcrumb {
  font-family: 'Barlow Condensed', sans-serif;
  font-size: 12px; font-weight: 600; letter-spacing: 0.18em;
  color: rgba(255,255,255,0.4); text-transform: uppercase;
  margin-bottom: 24px;
  display: flex; align-items: center; gap: 10px;
}
.breadcrumb a { color: rgba(255,255,255,0.5); text-decoration: none; transition: color 0.2s; }
.breadcrumb a:hover { color: var(--c-teal2); }
.breadcrumb .sep { color: rgba(255,255,255,0.2); }
.breadcrumb .current { color: var(--c-teal2); }
.page-tag {
  font-family: 'NanumSquare', sans-serif;
  font-size: 11px; letter-spacing: 0.2em;
  color: var(--c-teal2); text-transform: uppercase;
  margin-bottom: 16px; display: block;
}
.page-title {
  font-family: 'Barlow Condensed', 'NanumSquare', sans-serif;
  font-size: clamp(40px, 5vw, 64px);
  font-weight: 800; line-height: 1.05; letter-spacing: -0.01em;
  color: var(--c-white); margin-bottom: 20px;
  text-transform: uppercase;
}
.page-title em { color: var(--c-teal2); font-style: normal; }
.page-subtitle {
  font-size: 15px; line-height: 1.8;
  color: rgba(255,255,255,0.55);
  max-width: 640px;
}

.products-wrap { background: var(--c-cream); }
.products-inner { max-width: 1400px; margin: 0 auto; padding: 80px; }
.products-count {
  display: flex; align-items: baseline; justify-content: space-between;
  margin-bottom: 56px;
  padding-bottom: 28px;
  border-bottom: 1px solid var(--c-warm);
}
.products-count-num {
  font-family: 'Barlow Condensed', sans-serif;
  font-size: 18px; font-weight: 700;
  color: var(--c-text); letter-spacing: 0.05em;
}
.products-count-num strong {
  font-size: 32px; color: var(--c-teal);
  font-weight: 800; margin-right: 6px;
}
.products-sort { font-size: 12px; color: var(--c-muted); letter-spacing: 0.1em; text-transform: uppercase; }

.product-empty {
  border: 1.5px dashed var(--c-warm);
  background: rgba(255,255,255,0.4);
  padding: 64px 32px; text-align: center;
}
.product-empty-tag {
  font-family: 'Barlow Condensed', sans-serif;
  font-size: 11px; letter-spacing: 0.2em;
  color: var(--c-muted); text-transform: uppercase;
  margin-bottom: 10px;
}
.product-empty-text {
  font-size: 14px; color: var(--c-muted); line-height: 1.7;
}

/* ─── 제품 썸네일 선택 바 ─── */
.product-thumbs {
  display: flex; align-items: center; gap: 12px;
  margin-bottom: 56px;
  scroll-margin-top: calc(var(--nav-h) + var(--tabs-h, 0px) + 20px);
}
.product-thumbs-track {
  flex: 1; min-width: 0;
  display: flex; gap: 8px;
  overflow-x: auto; overflow-y: hidden;
  scroll-behavior: smooth;
  -webkit-overflow-scrolling: touch;
  padding: 2px 2px 8px;
  scrollbar-width: thin;
  scrollbar-color: rgba(0,0,0,0.2) var(--c-warm);
}
.product-thumbs-track::-webkit-scrollbar { height: 6px; }
.product-thumbs-track::-webkit-scrollbar-track { background: var(--c-warm); border-radius: 3px; }
.product-thumbs-track::-webkit-scrollbar-thumb { background: rgba(0,0,0,0.2); border-radius: 3px; }
.product-thumbs-track::-webkit-scrollbar-thumb:hover { background: rgba(0,0,0,0.35); }

.product-thumb {
  flex: 0 0 auto;
  display: inline-flex; align-items: center;
  background: var(--c-white);
  border: 1px solid var(--c-warm);
  border-radius: 999px;
  padding: 9px 18px; margin: 0;
  cursor: pointer; white-space: nowrap;
  font-family: 'NanumSquare', sans-serif;
  font-size: 13px; font-weight: 700;
  color: var(--c-muted); line-height: 1;
  transition: background 0.2s, color 0.2s, border-color 0.2s;
}
.product-thumb:hover { border-color: var(--c-teal2); color: var(--c-text); }
.product-thumb.active {
  background: var(--c-teal);
  border-color: var(--c-teal);
  color: var(--c-white);
}

.thumb-nav {
  flex: 0 0 auto;
  width: 34px; height: 34px; border-radius: 50%;
  border: 1px solid var(--c-warm); background: var(--c-white);
  color: var(--c-text); cursor: pointer;
  font-family: 'Barlow Condensed', sans-serif;
  font-size: 22px; line-height: 1;
  display: flex; align-items: center; justify-content: center;
  transition: background 0.2s, color 0.2s, border-color 0.2s, opacity 0.2s;
}
.thumb-nav:hover:not(:disabled) {
  background: var(--c-teal); color: var(--c-white); border-color: var(--c-teal);
}
.thumb-nav:disabled { opacity: 0.3; cursor: default; }
.thumb-nav[hidden] { display: none; }

/* 제품 본문 — 한 번에 하나만 표시 */
.product-slot { display: none; }
.product-slot.active { display: block; }

.cta {
  background: var(--c-dark);
  padding: 100px 80px;
  text-align: center;
  position: relative; overflow: hidden;
}
.cta::before {
  content: '';
  position: absolute; inset: 0; pointer-events: none;
  background-image:
    linear-gradient(rgba(255,255,255,0.015) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,0.015) 1px, transparent 1px);
  background-size: 60px 60px;
}
.cta-inner { position: relative; z-index: 2; max-width: 720px; margin: 0 auto; }
.cta-tag {
  font-family: 'Barlow Condensed', sans-serif;
  font-size: 12px; letter-spacing: 0.2em;
  color: var(--c-teal2); margin-bottom: 16px;
  text-transform: uppercase;
}
.cta-title {
  font-family: 'Barlow Condensed', 'NanumSquare', sans-serif;
  font-size: clamp(28px, 3.5vw, 42px);
  font-weight: 700; color: var(--c-white);
  line-height: 1.3; margin-bottom: 16px;
}
.cta-desc { font-size: 14px; color: rgba(255,255,255,0.55); line-height: 1.7; margin-bottom: 36px; }
.cta-btns { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
.cta-btns .btn-primary {
  font-family: 'Barlow Condensed', 'NanumSquare', sans-serif;
  font-size: 14px; font-weight: 700; letter-spacing: 0.1em;
  text-transform: uppercase; text-decoration: none;
  padding: 14px 32px; border-radius: 4px;
  background: var(--c-teal2); color: var(--c-dark);
  transition: background 0.25s, transform 0.25s; display: inline-block;
}
.cta-btns .btn-primary:hover { background: var(--c-teal); transform: translateY(-2px); }
.cta-btns .btn-ghost {
  font-family: 'Barlow Condensed', 'NanumSquare', sans-serif;
  font-size: 14px; font-weight: 600; letter-spacing: 0.1em;
  text-transform: uppercase; text-decoration: none;
  padding: 14px 32px; border-radius: 4px;
  border: 1px solid rgba(255,255,255,0.2); color: rgba(255,255,255,0.7);
  transition: border-color 0.25s, color 0.25s; display: inline-block;
}
.cta-btns .btn-ghost:hover { border-color: var(--c-teal2); color: var(--c-teal2); }

@media (max-width: 768px) {
  .page-header { padding: calc(var(--nav-h) + 40px) 24px 40px; }
  .page-title { font-size: 32px; }
  .page-subtitle { font-size: 14px; }
  .products-inner { padding: 48px 24px; }
  .cta { padding: 64px 24px; }
  .breadcrumb { font-size: 11px; flex-wrap: wrap; }
  .product-thumbs { margin-bottom: 36px; gap: 0; }
  .thumb-nav { display: none; }
}
</style>

<script>
// 제품 썸네일 갤러리 — 썸네일을 클릭하면 해당 제품 1건만 표시
document.addEventListener('astro:page-load', initProductGallery);
initProductGallery();

function initProductGallery() {
  const bar = document.querySelector<HTMLElement>('.product-thumbs');
  const thumbs = Array.from(document.querySelectorAll<HTMLButtonElement>('.product-thumb'));
  const slots = Array.from(document.querySelectorAll<HTMLElement>('.product-slot'));
  if (slots.length === 0) return;

  // ── 제품 전환 ──
  function showProduct(slug: string, doScroll: boolean) {
    slots.forEach((s) => {
      const match = s.dataset.product === slug;
      s.classList.toggle('active', match);
      if (match) {
        s.querySelectorAll<HTMLElement>('.reveal').forEach((el) => {
          el.style.opacity = '1';
          el.style.transform = 'none';
        });
      }
    });
    thumbs.forEach((t) => {
      const on = t.dataset.target === slug;
      t.classList.toggle('active', on);
      t.setAttribute('aria-selected', on ? 'true' : 'false');
    });
    try { history.replaceState(null, '', '#' + slug); } catch (e) {}
    if (doScroll && bar) {
      requestAnimationFrame(() => bar.scrollIntoView({ behavior: 'smooth', block: 'start' }));
    }
  }

  thumbs.forEach((t) => {
    t.addEventListener('click', () => {
      if (t.dataset.target) showProduct(t.dataset.target, true);
    });
  });

  // ── 진입 시 URL 해시(#슬러그)가 있으면 해당 제품 우선 표시 ──
  const hash = decodeURIComponent(location.hash.slice(1));
  if (hash && slots.some((s) => s.dataset.product === hash)) {
    showProduct(hash, false);
  }

  // ── 좌우 화살표 (썸네일이 넘칠 때만 노출) ──
  const track = document.querySelector<HTMLElement>('.product-thumbs-track');
  const prev = document.querySelector<HTMLButtonElement>('.thumb-nav-prev');
  const next = document.querySelector<HTMLButtonElement>('.thumb-nav-next');

  function updateArrows() {
    if (!track || !prev || !next) return;
    const scrollable = track.scrollWidth > track.clientWidth + 4;
    prev.hidden = !scrollable;
    next.hidden = !scrollable;
    if (!scrollable) return;
    prev.disabled = track.scrollLeft <= 1;
    next.disabled = track.scrollLeft >= track.scrollWidth - track.clientWidth - 1;
  }

  if (track && prev && next) {
    const step = () => Math.max(track.clientWidth * 0.8, 240);
    prev.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
    next.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));
    track.addEventListener('scroll', updateArrows, { passive: true });
    window.addEventListener('resize', updateArrows);
    updateArrows();
  }
}
</script>
