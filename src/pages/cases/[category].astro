---
// 동적 라우트: /cases/museum, /cases/library, ...
// 한 파일로 5개 카테고리 페이지를 모두 처리합니다.
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryTabs from '../../components/CategoryTabs.astro';
import CaseBlock from '../../components/CaseBlock.astro';
import { categoryMap, categoryMeta, enLabelMap } from '../../lib/categories';

// 정적 경로 생성 (5개 카테고리 페이지를 빌드 시 미리 생성)
export async function getStaticPaths() {
  return Object.keys(categoryMap).map(slug => ({
    params: { category: slug },
  }));
}

const { category: slugParam } = Astro.params;
const categoryName = categoryMap[slugParam as string];
if (!categoryName) {
  return Astro.redirect('/');
}

const meta = categoryMeta[categoryName];
const enLabel = enLabelMap[categoryName];

const allCases = await getCollection('cases', ({ data }) =>
  data.published && data.categories.includes(categoryName)
);
const cases = allCases.sort(
  (a, b) => b.data.published_date.valueOf() - a.data.published_date.valueOf()
);

const pageTitle = `${meta.title} 설치 사례 — (주)대원모빌랙`;
---

<BaseLayout title={pageTitle} description={meta.subtitle}>
  <section class="page-header">
    <div class="page-header-inner">
      <div class="breadcrumb">
        <a href="/">Home</a>
        <span class="sep">/</span>
        <a href="/#how">How to Use</a>
        <span class="sep">/</span>
        <span class="current">{meta.title} · {enLabel}</span>
      </div>
      <span class="page-tag">Installation Cases</span>
      <h1 class="page-title">{meta.title} <em>{meta.emTitle}</em></h1>
      <p class="page-subtitle">{meta.subtitle}</p>
    </div>
  </section>

  <CategoryTabs active={categoryName} />

  <section class="cases-wrap">
    <div class="cases-inner">
      <div class="cases-count reveal">
        <div class="cases-count-num">
          <strong>{String(cases.length).padStart(2, '0')}</strong>개의 {meta.title} 사례
        </div>
        <div class="cases-sort">최신순</div>
      </div>

      {cases.length > 0 ? (
        cases.map((entry, i) => (
          <CaseBlock entry={entry} caseNum={cases.length - i} />
        ))
      ) : (
        <div class="case-empty reveal">
          <div class="case-empty-tag">Coming Soon</div>
          <p class="case-empty-text">이 카테고리의 사례가 곧 업데이트됩니다.</p>
        </div>
      )}

      {cases.length > 0 && (
        <div class="case-placeholder reveal">
          <div class="case-placeholder-tag">Coming Soon</div>
          <p class="case-placeholder-text">
            다음 {meta.title} 설치 사례가 곧 업데이트됩니다.
          </p>
        </div>
      )}
    </div>
  </section>

  <section class="cta">
    <div class="cta-inner">
      <div class="cta-tag">Next Project</div>
      <h2 class="cta-title">{meta.title} 수장 환경을 계획 중이신가요?</h2>
      <p class="cta-desc">
        유물·자료의 하중·재질·특성에 맞춘 1:1 맞춤 설계부터 시공·유지보수까지.<br>
        대원모빌랙이 40년의 경험으로 함께합니다.
      </p>
      <div class="cta-btns">
        <button class="btn-primary">견적 문의하기</button>
        <a href="/#how" class="btn-ghost">다른 분야 사례 보기</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
.page-header {
  background: var(--c-dark);
  padding: calc(var(--nav-h) + 64px) 80px 56px;
  position: relative; overflow: hidden;
}
.page-header::before {
  content: '';
  position: absolute; inset: 0; pointer-events: none;
  background-image:
    linear-gradient(rgba(255,255,255,0.015) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,0.015) 1px, transparent 1px);
  background-size: 60px 60px;
}
.page-header-inner { position: relative; z-index: 2; max-width: 1400px; margin: 0 auto; }
.breadcrumb {
  font-family: 'Barlow Condensed', sans-serif;
  font-size: 12px; font-weight: 600; letter-spacing: 0.18em;
  color: rgba(255,255,255,0.4); text-transform: uppercase;
  margin-bottom: 24px;
  display: flex; align-items: center; gap: 10px;
}
.breadcrumb a { color: rgba(255,255,255,0.5); text-decoration: none; transition: color 0.2s; }
.breadcrumb a:hover { color: var(--c-teal2); }
.breadcrumb .sep { color: rgba(255,255,255,0.2); }
.breadcrumb .current { color: var(--c-teal2); }
.page-tag {
  font-family: 'NanumSquare', sans-serif;
  font-size: 11px; letter-spacing: 0.2em;
  color: var(--c-teal2); text-transform: uppercase;
  margin-bottom: 16px; display: block;
}
.page-title {
  font-family: 'Barlow Condensed', 'NanumSquare', sans-serif;
  font-size: clamp(40px, 5vw, 64px);
  font-weight: 800; line-height: 1.05; letter-spacing: -0.01em;
  color: var(--c-white); margin-bottom: 20px;
  text-transform: uppercase;
}
.page-title em { color: var(--c-teal2); font-style: normal; }
.page-subtitle {
  font-size: 15px; line-height: 1.8;
  color: rgba(255,255,255,0.55);
  max-width: 640px;
}

.cases-wrap { background: var(--c-cream); }
.cases-inner { max-width: 1400px; margin: 0 auto; padding: 80px; }
.cases-count {
  display: flex; align-items: baseline; justify-content: space-between;
  margin-bottom: 56px;
  padding-bottom: 28px;
  border-bottom: 1px solid var(--c-warm);
}
.cases-count-num {
  font-family: 'Barlow Condensed', sans-serif;
  font-size: 18px; font-weight: 700;
  color: var(--c-text); letter-spacing: 0.05em;
}
.cases-count-num strong {
  font-size: 32px; color: var(--c-teal);
  font-weight: 800; margin-right: 6px;
}
.cases-sort { font-size: 12px; color: var(--c-muted); letter-spacing: 0.1em; text-transform: uppercase; }

.case-empty, .case-placeholder {
  border: 1.5px dashed var(--c-warm);
  background: rgba(255,255,255,0.4);
  padding: 64px 32px; text-align: center;
}
.case-placeholder { margin-top: 64px; }
.case-empty-tag, .case-placeholder-tag {
  font-family: 'Barlow Condensed', sans-serif;
  font-size: 11px; letter-spacing: 0.2em;
  color: var(--c-muted); text-transform: uppercase;
  margin-bottom: 10px;
}
.case-empty-text, .case-placeholder-text {
  font-size: 14px; color: var(--c-muted); line-height: 1.7;
}

.cta {
  background: var(--c-dark);
  padding: 100px 80px;
  text-align: center;
  position: relative; overflow: hidden;
}
.cta::before {
  content: '';
  position: absolute; inset: 0; pointer-events: none;
  background-image:
    linear-gradient(rgba(255,255,255,0.015) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,0.015) 1px, transparent 1px);
  background-size: 60px 60px;
}
.cta-inner { position: relative; z-index: 2; max-width: 720px; margin: 0 auto; }
.cta-tag {
  font-family: 'Barlow Condensed', sans-serif;
  font-size: 12px; letter-spacing: 0.2em;
  color: var(--c-teal2); margin-bottom: 16px;
  text-transform: uppercase;
}
.cta-title {
  font-family: 'Barlow Condensed', 'NanumSquare', sans-serif;
  font-size: clamp(28px, 3.5vw, 42px);
  font-weight: 700; color: var(--c-white);
  line-height: 1.3; margin-bottom: 16px;
}
.cta-desc { font-size: 14px; color: rgba(255,255,255,0.55); line-height: 1.7; margin-bottom: 36px; }
.cta-btns { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }

@media (max-width: 768px) {
  .page-header { padding: calc(var(--nav-h) + 40px) 24px 40px; }
  .page-title { font-size: 32px; }
  .page-subtitle { font-size: 14px; }
  .cases-inner { padding: 48px 24px; }
  .cta { padding: 64px 24px; }
  .breadcrumb { font-size: 11px; flex-wrap: wrap; }
}
</style>
