    animation: fadeUp 0.8s var(--ease) 1.5s forwards;
  }
  .hero-stat-num { font-size: 28px; }
  .hero-right { height: 62vh; min-height: 380px; order: 0; }
  .hero-grid { position: relative; height: 100%; inset: auto; display: block; gap: 0; }

  /* ── SECTION COMMON ── */
  .section { padding: 64px 24px; }
  .section-h2 { font-size: clamp(36px, 10vw, 52px); }

  /* ── STORY ── */
  .story-grid { grid-template-columns: 1fr; gap: 40px; }
  .story-quote p { font-size: 18px; }

  /* ── CERT MARQUEE ── */
  .cert-item { padding: 0 20px; font-size: 11px; }

  /* ── PRODUCTS ── */
  .products-header { flex-direction: column; align-items: flex-start; gap: 20px; }
  .product-filter { justify-content: flex-start; }
  .products-grid { grid-template-columns: 1fr; }
  .product-img { height: 200px !important; }

  /* ── BENEFITS ── */
  .benefits {
    padding: 48px 24px;
  }
  .benefit { padding: 28px 16px; }
  .benefit-num { font-size: 36px; }

  /* ── HOW TO USE ── */
  .how-grid { grid-template-columns: 1fr 1fr; }
  .use-cases { grid-template-columns: repeat(3, 1fr); }

  /* ── SUPPORT ── */
  .support-grid { grid-template-columns: 1fr; gap: 40px; }

  /* ── FAQ ── */
  .faq-section { padding: 0 24px 64px; }
