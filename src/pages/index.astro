}

@media (max-width: 480px) {
  /* ── 더 작은 화면 ── */
  .hero-right { height: 54vh; min-height: 320px; }
  .how-grid { grid-template-columns: 1fr; }
  .use-cases { grid-template-columns: repeat(2, 1fr); }
  .benefits { grid-template-columns: 1fr; }
  .benefit { border-right: none !important; }
  .benefit:not(:last-child) { border-bottom: 1px solid var(--c-warm); }
  .footer-top { grid-template-columns: 1fr; }
  .product-filter { gap: 6px; }
  .filter-btn { font-size: 11px; padding: 6px 12px; }
