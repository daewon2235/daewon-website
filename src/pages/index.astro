</style>

<script>
// 메인 페이지 인터랙션
// (햄버거 메뉴와 스크롤 리빌은 Nav.astro / BaseLayout에서 처리됨)

// FAQ 아코디언 — 내용(사진 포함) 실제 높이에 맞춰 펼침
document.querySelectorAll('.faq-q').forEach((q) => {
  q.addEventListener('click', () => {
    const item = q.closest('.faq-item');
    if (!item) return;
    const wasOpen = item.classList.contains('open');
    document.querySelectorAll('.faq-item').forEach(i => {
      i.classList.remove('open');
      const a = i.querySelector('.faq-a');
      if (a) a.style.maxHeight = null;
    });
    if (!wasOpen) {
      item.classList.add('open');
      const a = item.querySelector('.faq-a');
      if (a) a.style.maxHeight = a.scrollHeight + 'px';
    }
  });
});

// 답변 속 사진이 뒤늦게 로드되면 펼쳐진 항목 높이를 다시 맞춤
document.querySelectorAll('.faq-a img').forEach((img) => {
  img.addEventListener('load', () => {
    const item = img.closest('.faq-item');
    const a = img.closest('.faq-a');
    if (item && a && item.classList.contains('open')) {
      a.style.maxHeight = a.scrollHeight + 'px';
    }
  });
});

// 제품 필터 (시각적 활성 표시만; 실제 필터링은 추후 동적 데이터 연결 시 구현)
document.querySelectorAll('.filter-btn').forEach((btn) => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
  });
});

// 제품 태그 "+ 더 보기" 토글
document.querySelectorAll('.product-tag-toggle').forEach((btn) => {
  btn.addEventListener('click', (e) => {
    e.preventDefault();   // 부모 카드 링크(<a>) 이동 방지
    e.stopPropagation();
    const tags = btn.closest('.product-tags');
    if (!tags) return;
    const isExpanded = tags.classList.toggle('expanded');
    btn.textContent = isExpanded ? '− 접기' : '+ 더 보기';
  });
});

// Stagger reveal delays (카드들을 순차적으로 등장시키기)
document.querySelectorAll('.how-card, .benefit, .use-case, .vision-card').forEach((el, i) => {
  (el as HTMLElement).style.transitionDelay = `${i * 0.1}s`;
});

// 견적·A/S·대리점 카드 클릭 → Contact Us 상자로 시선 유도 (스크롤은 href="#contact"가 담당)
const contactCard = document.getElementById('contact');
document.querySelectorAll('.js-flash').forEach((el) => {
  el.addEventListener('click', () => {
    if (!contactCard) return;
    contactCard.classList.remove('flash');
    void (contactCard as HTMLElement).offsetWidth; // 리플로우 → 연속 클릭에도 애니메이션 재시작
    contactCard.classList.add('flash');
  });
});
if (contactCard) {
  contactCard.addEventListener('animationend', () => contactCard.classList.remove('flash'));
}

// 준비중 카드(카탈로그·DW MALL) 클릭 → 안내 토스트 (맨 위로 튀지 않음)
let soonToast: HTMLElement | null = null;
let soonTimer = 0;
function showSoonToast(msg: string) {
  if (!soonToast) {
    soonToast = document.createElement('div');
    soonToast.className = 'soon-toast';
    document.body.appendChild(soonToast);
  }
  soonToast.textContent = msg;
  void soonToast.offsetWidth;
  soonToast.classList.add('show');
  window.clearTimeout(soonTimer);
  soonTimer = window.setTimeout(() => { if (soonToast) soonToast.classList.remove('show'); }, 2800);
}
document.querySelectorAll('.js-soon').forEach((el) => {
  const handler = () => showSoonToast((el as HTMLElement).dataset.soonMsg || '준비 중입니다.');
  el.addEventListener('click', handler);
  el.addEventListener('keydown', (e) => {
    const ke = e as KeyboardEvent;
    if (ke.key === 'Enter' || ke.key === ' ') { ke.preventDefault(); handler(); }
  });
});
</script>

<script>
  const heroSlides = Array.from(document.querySelectorAll('.hero-img'));
  const heroDotsWrap = document.getElementById('heroDots');
  if (heroSlides.length && heroDotsWrap) {
    let heroIdx = Math.max(0, heroSlides.findIndex(s => s.classList.contains('active')));
    let heroTimer = null;
    const heroDotEls = [];
    function heroShow(i) {
      heroIdx = i;
      heroSlides.forEach((s, j) => s.classList.toggle('active', j === i));
      heroDotEls.forEach((d, j) => d.classList.toggle('active', j === i));
    }
    function heroStart() { heroTimer = setInterval(() => heroShow((heroIdx + 1) % heroSlides.length), 5500); }
    function heroGo(i) { heroShow(i); clearInterval(heroTimer); heroStart(); }
    heroSlides.forEach((_, i) => {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'hero-dot' + (i === heroIdx ? ' active' : '');
      b.setAttribute('aria-label', (i + 1) + '번 사진 보기');
      b.addEventListener('click', () => heroGo(i));
      heroDotsWrap.appendChild(b);
      heroDotEls.push(b);
    });
    heroStart();
  }
</script>
